/-- The equivalence relation generated by lifted unstable plaques equals the relation whose classes
are the ranges of pointed intrinsic unstable-leaf lifts. (HPS, §7, p.116; Hatcher, Prop. 1.34) -/
theorem covering_unstable_plaque_relation_eq
    {E : Type w} [TopologicalSpace E]
    (p : E → M) (hp : IsCoveringMap p) (R : E → E → Prop)
    (UL : ∀ x : E, F.ULeaf (p x) → E)
    (hUL : ∀ x, Continuous (UL x))
    (hproj : ∀ x z, p (UL x z) = z.val)
    (hpoint : ∀ x, UL x (F.uPoint (p x)) = x)
    (hrange : ∀ x, Set.range (UL x) = {y | Relation.EqvGen R x y}) :
    let link : E → E → Prop := fun x y ↦
      ∃ i : F.boxIndex, ∃ z : FoliationCoordinateDisk s, ∃ β : Path x y,
        ∀ r : unitInterval, ∃ w : FoliationCoordinateDisk t,
          p (β r) = ((F.box i).chart (z, w)).val
    ∀ x y, Relation.EqvGen link x y ↔ Relation.EqvGen R x y := by
  dsimp only
  let link : E → E → Prop := fun x y ↦
      ∃ i : F.boxIndex, ∃ z : FoliationCoordinateDisk s, ∃ β : Path x y,
        ∀ r : unitInterval, ∃ w : FoliationCoordinateDisk t,
          p (β r) = ((F.box i).chart (z, w)).val
  have hplaque (i : F.boxIndex) (z : FoliationCoordinateDisk s)
      (q : Quotient F.unstablePartition) (hq : F.unstableLabel i z = q) :
      letI := F.unstableTopology q
      IsOpenEmbedding (fun w : FoliationCoordinateDisk t ↦
        (⟨((F.box i).chart (z, w)).val,
          (F.unstable_label i z w).trans hq⟩ : IntrinsicFoliationLeaf F.unstablePartition q)) := by
    subst q
    exact F.unstable_plaque i z
  have hlink : ∀ x y, link x y → Relation.EqvGen R x y := by
    rintro x y ⟨i, z, β, hβ⟩
    choose w hw using hβ
    have hm (r : unitInterval) : p (β r) ∈ (F.box i).image := by
      rw [hw r]
      exact ((F.box i).chart (z, w r)).property
    let c : unitInterval → (F.box i).image := fun r ↦ ⟨p (β r), hm r⟩
    have hc : Continuous c := (hp.continuous.comp β.continuous).subtype_mk _
    have hwc : Continuous w := by
      have heq : w = fun r ↦ ((F.box i).chart.symm (c r)).2 := by
        funext r
        have heq : c r = (F.box i).chart (z, w r) := Subtype.ext (hw r)
        simp only [heq, Homeomorph.symm_apply_apply]
      rw [heq]
      exact ((F.box i).chart.symm.continuous.comp hc).snd
    have hlabel : F.unstableLabel i z = Quotient.mk F.unstablePartition (p x) :=
      (F.unstable_label i z (w 0)).symm.trans
        (congrArg (Quotient.mk _) (by simpa only [Path.source] using (hw 0).symm))
    let j : FoliationCoordinateDisk t → F.ULeaf (p x) := fun v ↦
      ⟨((F.box i).chart (z, v)).val, (F.unstable_label i z v).trans hlabel⟩
    have hj : Continuous j := (hplaque i z _ hlabel).continuous
    have heq : (fun r ↦ UL x (j (w r))) = β := hp.eq_of_comp_eq
      ((hUL x).comp (hj.comp hwc)) β.continuous
      (by funext r; exact (hproj x (j (w r))).trans (hw r).symm) 0 (by
        have hj0 : j (w 0) = F.uPoint (p x) := Subtype.ext (by
          change ((F.box i).chart (z, w 0)).val = p x
          simpa only [Path.source] using (hw 0).symm)
        simp only [hj0, hpoint, Path.source])
    have hy : y ∈ Set.range (UL x) := ⟨j (w 1), (congrFun heq 1).trans β.target⟩
    rwa [hrange x] at hy
  have hrangeLink : ∀ x z, Relation.EqvGen link x (UL x z) := by
    intro x z
    let : PreconnectedSpace (F.ULeaf (p x)) := (F.unstable_connected _).toPreconnectedSpace
    have hlocal : ∀ a : F.ULeaf (p x), ∃ V : Set (F.ULeaf (p x)),
        IsOpen V ∧ a ∈ V ∧ ∀ b ∈ V, link (UL x a) (UL x b) := by
      intro a
      obtain ⟨i, hi⟩ := F.cover a.val
      let c := (F.box i).chart.symm ⟨a.val, hi⟩
      have hca : ((F.box i).chart c).val = a.val :=
        congrArg Subtype.val ((F.box i).chart.apply_symm_apply ⟨a.val, hi⟩)
      have hlabel : F.unstableLabel i c.1 = Quotient.mk F.unstablePartition (p x) :=
        (F.unstable_label i c.1 c.2).symm.trans ((congrArg (Quotient.mk _) hca).trans a.property)
      let j : FoliationCoordinateDisk t → F.ULeaf (p x) := fun v ↦
        ⟨((F.box i).chart (c.1, v)).val, (F.unstable_label i c.1 v).trans hlabel⟩
      have hj : IsOpenEmbedding j := hplaque i c.1 _ hlabel
      have hja : j c.2 = a := Subtype.ext hca
      refine ⟨Set.range j, hj.isOpen_range, ⟨c.2, hja⟩, ?_⟩
      rintro b ⟨v, rfl⟩
      let : ContractibleSpace (FoliationCoordinateDisk t) :=
        (convex_ball (0 : Fin t → ℝ) 1).contractibleSpace ⟨0, by simp⟩
      let η := PathConnectedSpace.somePath c.2 v
      let β := ((η.map hj.continuous).map (hUL x)).cast
        (congrArg (UL x) hja).symm rfl
      refine ⟨i, c.1, β, fun r ↦ ⟨η r, hproj x (j (η r))⟩⟩
    have hmap : ∀ a b : F.ULeaf (p x),
        Relation.EqvGen (fun a b ↦ link (UL x a) (UL x b)) a b →
        Relation.EqvGen link (UL x a) (UL x b) := by
      intro a b h
      induction h with
      | rel a b h => exact Relation.EqvGen.rel _ _ h
      | refl a => exact Relation.EqvGen.refl _
      | symm a b _ ih => exact Relation.EqvGen.symm _ _ ih
      | trans a b c _ _ ih ih' => exact Relation.EqvGen.trans _ _ _ ih ih'
    have h := hmap _ _ (eqvGen_of_preconnected_local_relation_g10
      (fun a b : F.ULeaf (p x) ↦ link (UL x a) (UL x b)) hlocal (F.uPoint (p x)) z)
    simpa only [hpoint] using h
  intro x y
  constructor
  · intro h
    induction h with
    | rel x y h => exact hlink x y h
    | refl x => exact Relation.EqvGen.refl x
    | symm x y _ ih => exact Relation.EqvGen.symm _ _ ih
    | trans x y z _ _ ih ih' => exact Relation.EqvGen.trans _ _ _ ih ih'
  · intro h
    have hy : y ∈ Set.range (UL x) := by rwa [hrange x]
    obtain ⟨z, rfl⟩ := hy
    exact hrangeLink x z
end HolomorphicAnosov
