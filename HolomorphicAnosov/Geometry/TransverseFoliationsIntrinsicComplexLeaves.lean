import HolomorphicAnosov.Geometry.ComplexModel
import HolomorphicAnosov.Geometry.Biholomorph
import Mathlib.Analysis.Normed.Group.Real
import Mathlib.Topology.Connected.Basic
import Mathlib.Logic.Relation

/-! Transverse continuous foliations are described by product boxes and intrinsic leaf
topologies generated by plaques, with complex manifold structures on unstable leaves.
(Hirsch–Pugh–Shub, §7, pp. 115–116; Ghys, pp. 589, 594; Zhang, p. 10) -/

namespace HolomorphicAnosov

open Set _root_.Topology
open scoped ContDiff

universe u v

set_option autoImplicit false

/-- The open unit ball in `Fin d → ℝ`, used as a foliation coordinate disk.
(Hirsch–Pugh–Shub, §7, p. 115) -/
abbrev FoliationCoordinateDisk (d : ℕ) := ↥(Metric.ball (0 : Fin d → ℝ) 1)

/-- The subtype of points in a fixed equivalence class of a partition.
(Hirsch–Pugh–Shub, §7, pp. 115–116) -/
abbrev IntrinsicFoliationLeaf {M : Type u} (R : Setoid M) (q : Quotient R) :=
  {x : M // Quotient.mk R x = q}

/-- A common continuous product box for two transverse foliations.
(Hirsch–Pugh–Shub, §7, p. 115; Ghys, pp. 589, 594) -/
structure TransverseFoliationBox (s t : ℕ) (M : Type u) [TopologicalSpace M] where
  image : Set M
  isOpen_image : IsOpen image
  chart : (FoliationCoordinateDisk s × FoliationCoordinateDisk t) ≃ₜ ↥image

/-- A pair of transverse continuous foliations whose leaves are plaque-chain classes
with intrinsic manifold topologies generated by plaque charts.
(Hirsch–Pugh–Shub, §7, pp. 115–116; Ghys, pp. 589, 594; Zhang, p. 10) -/
structure TransverseContinuousFoliations (s t : ℕ) (M : Type u)
    [TopologicalSpace M] [T2Space M] [SecondCountableTopology M]
    [ChartedSpace (Fin (s + t) → ℝ) M] where
  boxIndex : Type v
  box : boxIndex → TransverseFoliationBox s t M
  cover : ∀ x : M, ∃ i : boxIndex, x ∈ (box i).image
  stablePartition : Setoid M
  unstablePartition : Setoid M
  stable_generated : ∀ x y : M,
    stablePartition x y ↔ Relation.EqvGen
      (fun a b ↦ ∃ i : boxIndex, ∃ w : FoliationCoordinateDisk t,
        ∃ z z' : FoliationCoordinateDisk s,
          ((box i).chart (z, w)).val = a ∧ ((box i).chart (z', w)).val = b) x y
  unstable_generated : ∀ x y : M,
    unstablePartition x y ↔ Relation.EqvGen
      (fun a b ↦ ∃ i : boxIndex, ∃ z : FoliationCoordinateDisk s,
        ∃ w w' : FoliationCoordinateDisk t,
          ((box i).chart (z, w)).val = a ∧ ((box i).chart (z, w')).val = b) x y
  stableTopology : ∀ q : Quotient stablePartition,
    TopologicalSpace (IntrinsicFoliationLeaf stablePartition q)
  unstableTopology : ∀ q : Quotient unstablePartition,
    TopologicalSpace (IntrinsicFoliationLeaf unstablePartition q)
  stableCharts : ∀ q : Quotient stablePartition,
    letI := stableTopology q
    ChartedSpace (Fin s → ℝ) (IntrinsicFoliationLeaf stablePartition q)
  unstableCharts : ∀ q : Quotient unstablePartition,
    letI := unstableTopology q
    ChartedSpace (Fin t → ℝ) (IntrinsicFoliationLeaf unstablePartition q)
  stable_connected : ∀ q : Quotient stablePartition,
    letI := stableTopology q
    ConnectedSpace (IntrinsicFoliationLeaf stablePartition q)
  unstable_connected : ∀ q : Quotient unstablePartition,
    letI := unstableTopology q
    ConnectedSpace (IntrinsicFoliationLeaf unstablePartition q)
  stable_inclusion : ∀ q : Quotient stablePartition,
    letI := stableTopology q
    Continuous (fun x : IntrinsicFoliationLeaf stablePartition q ↦ x.val)
  unstable_inclusion : ∀ q : Quotient unstablePartition,
    letI := unstableTopology q
    Continuous (fun x : IntrinsicFoliationLeaf unstablePartition q ↦ x.val)
  stableLabel : ∀ _i : boxIndex, FoliationCoordinateDisk t → Quotient stablePartition
  unstableLabel : ∀ _i : boxIndex, FoliationCoordinateDisk s → Quotient unstablePartition
  stable_label : ∀ (i : boxIndex) (z : FoliationCoordinateDisk s)
    (w : FoliationCoordinateDisk t),
    Quotient.mk stablePartition ((box i).chart (z, w)).val = stableLabel i w
  unstable_label : ∀ (i : boxIndex) (z : FoliationCoordinateDisk s)
    (w : FoliationCoordinateDisk t),
    Quotient.mk unstablePartition ((box i).chart (z, w)).val = unstableLabel i z
  stable_plaque : ∀ (i : boxIndex) (w : FoliationCoordinateDisk t),
    letI := stableTopology (stableLabel i w)
    IsOpenEmbedding (fun z : FoliationCoordinateDisk s ↦
      (⟨((box i).chart (z, w)).val, stable_label i z w⟩ :
        IntrinsicFoliationLeaf stablePartition (stableLabel i w)))
  unstable_plaque : ∀ (i : boxIndex) (z : FoliationCoordinateDisk s),
    letI := unstableTopology (unstableLabel i z)
    IsOpenEmbedding (fun w : FoliationCoordinateDisk t ↦
      (⟨((box i).chart (z, w)).val, unstable_label i z w⟩ :
        IntrinsicFoliationLeaf unstablePartition (unstableLabel i z)))
  stable_topology_generated : ∀ (q : Quotient stablePartition)
    (W : Set (IntrinsicFoliationLeaf stablePartition q)),
    letI := stableTopology q
    IsOpen W ↔ ∀ (i : boxIndex) (w : FoliationCoordinateDisk t)
      (h : stableLabel i w = q),
      IsOpen ((fun z : FoliationCoordinateDisk s ↦
        (⟨((box i).chart (z, w)).val, (stable_label i z w).trans h⟩ :
          IntrinsicFoliationLeaf stablePartition q)) ⁻¹' W)
  unstable_topology_generated : ∀ (q : Quotient unstablePartition)
    (W : Set (IntrinsicFoliationLeaf unstablePartition q)),
    letI := unstableTopology q
    IsOpen W ↔ ∀ (i : boxIndex) (z : FoliationCoordinateDisk s)
      (h : unstableLabel i z = q),
      IsOpen ((fun w : FoliationCoordinateDisk t ↦
        (⟨((box i).chart (z, w)).val, (unstable_label i z w).trans h⟩ :
          IntrinsicFoliationLeaf unstablePartition q)) ⁻¹' W)

/-- Complex one-dimensional manifold structures on the unstable leaves, using their
intrinsic topologies. (Ghys, pp. 589, 594; Zhang, p. 10; Hirsch–Pugh–Shub, p. 116) -/
structure IntrinsicComplexUnstableLeaves {s t : ℕ} {M : Type u}
    [TopologicalSpace M] [T2Space M] [SecondCountableTopology M]
    [ChartedSpace (Fin (s + t) → ℝ) M]
    (F : TransverseContinuousFoliations.{u, v} s t M) where
  real_dimension : t = 2
  charts : ∀ q : Quotient F.unstablePartition,
    letI := F.unstableTopology q
    ChartedSpace (ComplexModel 1) (IntrinsicFoliationLeaf F.unstablePartition q)
  complex_manifold : ∀ q : Quotient F.unstablePartition,
    letI := F.unstableTopology q
    letI := charts q
    IsManifold (complexModel 1) ∞ (IntrinsicFoliationLeaf F.unstablePartition q)

end HolomorphicAnosov
