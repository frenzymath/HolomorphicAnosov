import HolomorphicAnosov.Geometry.NativePartitionBoxLeafAtlasesG10
import HolomorphicAnosov.Geometry.LocalHolonomyPathContinuation
import HolomorphicAnosov.Geometry.FinitePlaqueChainsOfLocalCoverG10

noncomputable section
open scoped ContDiff Manifold Topology
open Set Filter _root_.Topology

universe u
namespace HolomorphicAnosov
attribute [local instance] complex_isManifold_real

/-- The native connected-leaf partition is the equivalence relation generated by the compatible
product-box plaques. (HPS, p.116) -/
theorem native_partition_generated_by_boxes_g10 {s t : ℕ}
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    {M : Type u} [TopologicalSpace M] [ChartedSpace E M] [IsManifold 𝓘(ℝ, E) ∞ M]
    {ι β : Type u} {L : ι → Type u}
    [∀ i, TopologicalSpace (L i)] [∀ i, ChartedSpace (Fin s → ℝ) (L i)]
    [∀ i, IsManifold 𝓘(ℝ, Fin s → ℝ) ∞ (L i)]
    (P : RealTangentDistribution 𝓘(ℝ, E) M)
    (F : HPS.LeafPartition P ι L (fun _ ↦ s))
    (B : β → TransverseFoliationBox s t M)
    (hcover : ∀ x : M, ∃ b, x ∈ (B b).image)
    (hplaque : ∀ b w, ∃ i : ι, ∃ j : FoliationCoordinateDisk s → L i,
      IsOpenEmbedding j ∧ ∀ z, ((B b).chart (z, w)).val = (F.leaf i).inclusion (j z)) :
    ∃ R : Setoid M,
      (∀ x y, R x y ↔ ∃ i a b, (F.leaf i).inclusion a = x ∧
        (F.leaf i).inclusion b = y) ∧
      (∀ x y, R x y ↔ Relation.EqvGen
        (fun a b ↦ ∃ i : β, ∃ w : FoliationCoordinateDisk t,
          ∃ z z' : FoliationCoordinateDisk s,
            ((B i).chart (z, w)).val = a ∧ ((B i).chart (z', w)).val = b) x y) := by
  classical
  let label : M → ι := fun x ↦ (F.cover x).choose
  let point : ∀ x : M, L (label x) := fun x ↦ (F.cover x).choose_spec.choose
  have hpoint (x : M) : (F.leaf (label x)).inclusion (point x) = x :=
    (F.cover x).choose_spec.choose_spec
  have hlabel (i : ι) (z : L i) : label ((F.leaf i).inclusion z) = i :=
    F.disjoint _ _ _ _ (hpoint _)
  let R : Setoid M := Setoid.ker label
  let step : M → M → Prop := fun a b ↦ ∃ i : β, ∃ w : FoliationCoordinateDisk t,
    ∃ z z' : FoliationCoordinateDisk s,
      ((B i).chart (z, w)).val = a ∧ ((B i).chart (z', w)).val = b
  have hR (x y : M) : R x y ↔ ∃ i a b,
      (F.leaf i).inclusion a = x ∧ (F.leaf i).inclusion b = y := by
    constructor
    · intro h
      change label x = label y at h
      have hy : y ∈ Set.range (F.leaf (label x)).inclusion := by
        rw [h]
        exact ⟨point y, hpoint y⟩
      obtain ⟨z, hz⟩ := hy
      exact ⟨label x, point x, z, hpoint x, hz⟩
    · rintro ⟨i, a, b, rfl, rfl⟩
      change label _ = label _
      rw [hlabel, hlabel]
  have hsR : ∀ x y, step x y → R x y := by
    rintro x y ⟨b, w, z, z', rfl, rfl⟩
    obtain ⟨i, j, hj, h⟩ := hplaque b w
    apply (hR _ _).mpr
    exact ⟨i, j z, j z', (h z).symm, (h z').symm⟩
  have hleaf (i : ι) (a b : L i) :
      Relation.EqvGen step ((F.leaf i).inclusion a) ((F.leaf i).inclusion b) := by
    let := (F.leaf i).connected
    let localStep : L i → L i → Prop := fun z z' ↦
      step ((F.leaf i).inclusion z) ((F.leaf i).inclusion z')
    have hlocal : ∀ z : L i, ∃ V : Set (L i), IsOpen V ∧ z ∈ V ∧
        ∀ z' ∈ V, localStep z z' := by
      intro z
      obtain ⟨b, hb⟩ := hcover ((F.leaf i).inclusion z)
      let v : (B b).image := ⟨(F.leaf i).inclusion z, hb⟩
      let zw := (B b).chart.symm v
      obtain ⟨i', j, hj, h⟩ := hplaque b zw.2
      have hz : (F.leaf i').inclusion (j zw.1) = (F.leaf i).inclusion z := by
        rw [← h zw.1]
        exact congrArg Subtype.val ((B b).chart.apply_symm_apply v)
      have hi : i' = i := F.disjoint _ _ _ _ hz
      subst i'
      have hjz : j zw.1 = z := (F.leaf i).injective hz
      refine ⟨Set.range j, hj.isOpen_range, ⟨zw.1, hjz⟩, ?_⟩
      rintro z' ⟨u, rfl⟩
      refine ⟨b, zw.2, zw.1, u, ?_, h u⟩
      exact (h zw.1).trans hz
    have hc := eqvGen_of_preconnected_local_relation_g10 localStep hlocal a b
    induction hc with
    | rel a b h => exact Relation.EqvGen.rel _ _ h
    | refl a => exact Relation.EqvGen.refl _
    | symm a b h ih => exact Relation.EqvGen.symm _ _ ih
    | trans a b c hab hbc ihab ihbc => exact Relation.EqvGen.trans _ _ _ ihab ihbc
  refine ⟨R, hR, ?_⟩
  intro x y
  constructor
  · intro h
    obtain ⟨i, a, b, rfl, rfl⟩ := (hR x y).mp h
    exact hleaf i a b
  · intro h
    induction h with
    | rel a b hab => exact hsR a b hab
    | refl a => exact R.refl a
    | symm a b hab ih => exact R.symm ih
    | trans a b c hab hbc ihab ihbc => exact R.trans ihab ihbc



end HolomorphicAnosov
