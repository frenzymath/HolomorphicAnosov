import HolomorphicAnosov.Geometry.NativeQuotientClassStructuresG10
import HolomorphicAnosov.Geometry.NativeQuotientPlaqueOpenG10
import HolomorphicAnosov.Geometry.TopologyGeneratedByOpenPlaqueCoverG10
import HolomorphicAnosov.Geometry.LocalHolonomyPathContinuation
import HolomorphicAnosov.Paper.Zhang.CoveringConjugacySupport.NativeAsymptoticDatumOfLeaf

noncomputable section
open scoped ContDiff Manifold Topology
open Set Filter _root_.Topology

universe u
namespace HolomorphicAnosov
attribute [local instance] complex_isManifold_real

/-- Native quotient leaves admit smooth atlases with the prescribed tangent distribution, box
labels, and intrinsic topology generated by open plaques. Each quotient leaf is diffeomorphic to
a native leaf. (HPS, p.116) -/
theorem native_partition_box_leaf_atlases_g10 {s t : ℕ}
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    {M : Type u} [TopologicalSpace M] [ChartedSpace E M] [IsManifold 𝓘(ℝ, E) ∞ M]
    {ι β : Type u} {L : ι → Type u}
    [∀ i, TopologicalSpace (L i)] [∀ i, ChartedSpace (Fin s → ℝ) (L i)]
    [∀ i, IsManifold 𝓘(ℝ, Fin s → ℝ) ∞ (L i)]
    (P : RealTangentDistribution 𝓘(ℝ, E) M)
    (F : HPS.LeafPartition P ι L (fun _ ↦ s)) (R : Setoid M)
    (hR : ∀ x y, R x y ↔ ∃ i a b,
      (F.leaf i).inclusion a = x ∧ (F.leaf i).inclusion b = y)
    (B : β → TransverseFoliationBox s t M)
    (hcover : ∀ x : M, ∃ b, x ∈ (B b).image)
    (hplaque : ∀ b w, ∃ i : ι, ∃ j : FoliationCoordinateDisk s → L i,
      IsOpenEmbedding j ∧ ∀ z, ((B b).chart (z, w)).val = (F.leaf i).inclusion (j z)) :
    ∃ label : β → FoliationCoordinateDisk t → Quotient R,
      ∃ hlabel : ∀ b z w, Quotient.mk R (((B b).chart (z, w)).val) = label b w,
      ∃ top : ∀ q, TopologicalSpace (IntrinsicFoliationLeaf R q), letI := top
      ∃ charts : ∀ q, ChartedSpace (Fin s → ℝ) (IntrinsicFoliationLeaf R q), letI := charts
        (∀ q, ConnectedSpace (IntrinsicFoliationLeaf R q)) ∧
        (∀ q, Continuous (Subtype.val : IntrinsicFoliationLeaf R q → M)) ∧
        (∀ b w, IsOpenEmbedding (fun z ↦
          (⟨((B b).chart (z, w)).val, hlabel b z w⟩ :
            IntrinsicFoliationLeaf R (label b w)))) ∧
        (∀ q (W : Set (IntrinsicFoliationLeaf R q)), IsOpen W ↔ ∀ b w
          (h : label b w = q), IsOpen ((fun z ↦
            (⟨((B b).chart (z, w)).val, (hlabel b z w).trans h⟩ :
              IntrinsicFoliationLeaf R q)) ⁻¹' W)) ∧
        (∀ q, IsManifold 𝓘(ℝ, Fin s → ℝ) ∞ (IntrinsicFoliationLeaf R q)) ∧
        (∀ q z, LinearMap.range (mfderiv 𝓘(ℝ, Fin s → ℝ) 𝓘(ℝ, E)
          (Subtype.val : IntrinsicFoliationLeaf R q → M) z).toLinearMap = P z.val) ∧
        (∀ q, ∃ i, ∃ e : Diffeomorph 𝓘(ℝ, Fin s → ℝ) 𝓘(ℝ, Fin s → ℝ)
          (L i) (IntrinsicFoliationLeaf R q) ∞, ∀ z, (e z).val = (F.leaf i).inclusion z) := by
  classical
  let z0 : FoliationCoordinateDisk s := ⟨0, Metric.mem_ball_self (by norm_num)⟩
  let label : β → FoliationCoordinateDisk t → Quotient R :=
    fun b w ↦ Quotient.mk R (((B b).chart (z0, w)).val)
  have hlabel : ∀ b z w, Quotient.mk R (((B b).chart (z, w)).val) = label b w := by
    intro b z w
    obtain ⟨i, j, hj, h⟩ := hplaque b w
    exact Quotient.sound ((hR _ _).mpr ⟨i, j z, j z0, (h z).symm, (h z0).symm⟩)
  let top : ∀ q, TopologicalSpace (IntrinsicFoliationLeaf R q) := fun q ↦
    (native_quotient_class_structures_g10 P F R hR q).choose
  let := top
  let charts : ∀ q, ChartedSpace (Fin s → ℝ) (IntrinsicFoliationLeaf R q) := fun q ↦
    (native_quotient_class_structures_g10 P F R hR q).choose_spec.choose
  let := charts
  have hdata (q : Quotient R) :=
    (native_quotient_class_structures_g10 P F R hR q).choose_spec.choose_spec
  have hopen (q : Quotient R) (b : β) (w : FoliationCoordinateDisk t)
      (htag : label b w = q) : IsOpenEmbedding (fun z ↦
        (⟨((B b).chart (z, w)).val, (hlabel b z w).trans htag⟩ :
          IntrinsicFoliationLeaf R q)) := by
    obtain ⟨i, e, he⟩ := (hdata q).2.2.2.2.2
    obtain ⟨k, j, hj, h⟩ := hplaque b w
    have htag' : ∀ z, Quotient.mk R ((F.leaf k).inclusion (j z)) = q := by
      intro z
      rw [← h z]
      exact (hlabel b z w).trans htag
    have hj' := native_quotient_plaque_open_g10 P F R q i e he k j hj htag'
    have hfun : (fun z ↦ (⟨((B b).chart (z, w)).val,
        (hlabel b z w).trans htag⟩ : IntrinsicFoliationLeaf R q)) =
        (fun z ↦ (⟨(F.leaf k).inclusion (j z), htag' z⟩ :
          IntrinsicFoliationLeaf R q)) := by
      funext z
      exact Subtype.ext (h z)
    rw [hfun]
    exact hj'
  refine ⟨label, hlabel, top, charts, (fun q ↦ (hdata q).2.1),
    (fun q ↦ (hdata q).2.2.1.continuous), (fun b w ↦ hopen _ b w rfl), ?_,
    (fun q ↦ (hdata q).1), (fun q ↦ (hdata q).2.2.2.2.1),
    (fun q ↦ (hdata q).2.2.2.2.2)⟩
  intro q W
  let J := {bw : β × FoliationCoordinateDisk t // label bw.1 bw.2 = q}
  let j : J → FoliationCoordinateDisk s → IntrinsicFoliationLeaf R q := fun bw z ↦
    ⟨((B bw.val.1).chart (z, bw.val.2)).val, (hlabel bw.val.1 z bw.val.2).trans bw.property⟩
  have hj : ∀ bw, IsOpenEmbedding (j bw) := fun bw ↦ hopen q _ _ bw.property
  have hjcover : ∀ x : IntrinsicFoliationLeaf R q, ∃ bw z, j bw z = x := by
    intro x
    obtain ⟨b, hb⟩ := hcover x.val
    let v : (B b).image := ⟨x.val, hb⟩
    let zw := (B b).chart.symm v
    have hv : ((B b).chart zw).val = x.val :=
      congrArg Subtype.val ((B b).chart.apply_symm_apply v)
    have hq : label b zw.2 = q := by
      rw [← hlabel b zw.1 zw.2]
      change Quotient.mk R (((B b).chart zw).val) = q
      rw [hv]
      exact x.property
    exact ⟨⟨(b, zw.2), hq⟩, zw.1, Subtype.ext hv⟩
  rw [isOpen_iff_forall_openEmbedding_preimage_g10 j hj hjcover W]
  constructor
  · intro h b w hq
    exact h ⟨(b, w), hq⟩
  · intro h bw
    exact h bw.val.1 bw.val.2 bw.property



end HolomorphicAnosov
