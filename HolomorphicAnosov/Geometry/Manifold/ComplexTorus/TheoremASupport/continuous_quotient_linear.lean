namespace HolomorphicAnosov.TheoremAProof.QuotientCalculus
open Filter _root_.Topology
noncomputable section

/-- The automorphism induced by a lattice-preserving linear equivalence is continuous on the complex
torus. -/
theorem continuous_quotient_linear {d : ℕ} {L : FullComplexLattice d}
    (A : LatticeLinearEquiv L) :
    Continuous (quotientLinearEquiv A : ComplexTorus L → ComplexTorus L) := by
  apply (QuotientAddGroup.isQuotientMap_mk L.lattice.toAddSubgroup).continuous_iff.mpr
  change Continuous (fun z : ComplexModel d => QuotientAddGroup.mk (A.linear z))
  exact QuotientAddGroup.continuous_mk.comp A.linear.toContinuousLinearEquiv.continuous


end
end HolomorphicAnosov.TheoremAProof.QuotientCalculus
