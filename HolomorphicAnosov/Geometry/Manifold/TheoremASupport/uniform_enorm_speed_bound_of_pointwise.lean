namespace HolomorphicAnosov.TheoremAProof.Dimension
open Set Filter Manifold Bundle HolomorphicAnosov
open scoped Bundle ContDiff Manifold _root_.Topology
noncomputable section
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
  {H : Type*} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}
  {M : Type*} [TopologicalSpace M] [ChartedSpace H M]
  [IsManifold I 1 M]
  [Bundle.RiemannianBundle (fun x : M ↦ TangentSpace I x)]
  [IsContinuousRiemannianBundle E (fun x : M ↦ TangentSpace I x)]

variable [ProperSpace E]
open MeasureTheory
open scoped ENNReal
attribute [local instance] complex_isManifold_real
universe u
set_option maxHeartbeats 800000

theorem uniform_enorm_speed_bound_of_pointwise
    [CompactSpace M] [Nonempty M]
    (F : M → M) (hF : ContMDiff I I 1 F)
    (hstrict : ∀ x, ‖mfderiv I I F x‖ < 1) :
    ∃ K : ENNReal, 0 < K ∧ K < 1 ∧
      ∀ x (v : TangentSpace I x), ‖mfderiv I I F x v‖ₑ ≤ K * ‖v‖ₑ := by
  obtain ⟨q, hq0, hq1, hq⟩ := uniform_speed_bound_of_pointwise F hF hstrict
  refine ⟨ENNReal.ofReal q, ENNReal.ofReal_pos.mpr hq0, ?_, ?_⟩
  · exact ENNReal.ofReal_lt_one.mpr hq1
  · intro x v
    have H := ENNReal.ofReal_le_ofReal (hq x v)
    simpa only [ofReal_norm, ENNReal.ofReal_mul hq0.le] using H


end
end HolomorphicAnosov.TheoremAProof.Dimension
