noncomputable section
universe u
open Set Filter Function ODE Metric
open scoped Manifold ContDiff Topology NNReal

namespace SmoothFlowBootstrap
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- The actual derivative has the expected two components. -/
theorem jointDerivative_apply (Y : E × ℝ → E →L[ℝ] E) (V : E × ℝ → E)
    (p : E × ℝ) (h : E) (s : ℝ) :
    jointDerivative Y V p (h, s) = Y p h + s • V p := by
  simp [jointDerivative]

end SmoothFlowBootstrap
