noncomputable section
universe u
open Set Filter Function ODE Metric
open scoped Manifold ContDiff Topology NNReal

namespace SmoothFlowBootstrap
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- The actual augmented autonomous field, with no supplied jet data. -/
def augmentedField (F : E → E) : E × (E →L[ℝ] E) → E × (E →L[ℝ] E) :=
  fun p ↦ (F p.1, (fderiv ℝ F p.1).comp p.2)

end SmoothFlowBootstrap
