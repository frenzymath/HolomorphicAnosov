open scoped Manifold ContDiff Topology NNReal

namespace FirstVariationalDefect
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- The dependence on a nonnegative forcing size is exactly homogeneous. -/
theorem gronwall_forcing_homogeneous (K ε T : ℝ) :
    gronwallBound 0 K ε T = ε * gronwallBound 0 K 1 T := by
  unfold gronwallBound
  split_ifs <;> ring

end FirstVariationalDefect
