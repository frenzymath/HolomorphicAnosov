        hzero j hj, hQzero ⟨j, Nat.lt_trans hj (Nat.lt_succ_self n)⟩]
      exact sub_self _
    · intro t ht
      rw [show (fun t ↦ k (a + t • (y - a)) -
          ∑ l : Fin (n + 1), (l.val.factorial : ℝ)⁻¹ *
            T l (fun _ ↦ t • (y - a))) =
          (fun t ↦ k (a + t • (y - a))) -
            (fun t ↦ ∑ l : Fin (n + 1), (l.val.factorial : ℝ)⁻¹ *
