/-- The local deformation starts at the identity. -/
theorem cw_prism_deform_zero
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (p : Metric.closedBall (0 : E) 1 × unitInterval) :
    cw_prism_deform (0, p) = p := by
  apply Prod.ext
  · apply Subtype.ext
    simp [cw_prism_deform]
  · simp [cw_prism_deform]

end HolomorphicAnosov
