import Mathlib.Topology.ContinuousMap.Basic

namespace HolomorphicAnosov.Topology

/-- The two matched face maps have identical parametrizations in the quotient
generated by the face pairing. Source: Hatcher, Algebraic Topology, Theorem
2A.1 proof p.167. At each face parameter, the matching itself is a generating
relation, hence belongs to its equivalence closure and gives equality of the
quotient classes. Neither involutivity nor injectivity of face maps is needed. -/
theorem pairedQuotient_faces_eq
    {I J A B : Type*} [TopologicalSpace A] [TopologicalSpace B]
    (face : J → C(B, A)) (pair : I × J → I × J) (o : I × J) (t : B) :
    Quotient.mk (Relation.EqvGen.setoid
      (fun x y : I × A ↦ ∃ e : I × J, ∃ s : B,
        x = (e.1, face e.2 s) ∧ y = ((pair e).1, face (pair e).2 s)))
      (o.1, face o.2 t) =
    Quotient.mk (Relation.EqvGen.setoid
      (fun x y : I × A ↦ ∃ e : I × J, ∃ s : B,
        x = (e.1, face e.2 s) ∧ y = ((pair e).1, face (pair e).2 s)))
      ((pair o).1, face (pair o).2 t) := by
  exact Quotient.sound (Relation.EqvGen.rel _ _ ⟨o, t, rfl, rfl⟩)

end HolomorphicAnosov.Topology
