import HolomorphicAnosov.Topology.GraphSpanningTreeLoopCollapsedWedgeCollarCoverG3
import HolomorphicAnosov.Topology.IntervalWedgeLoopSubgroupG3
import HolomorphicAnosov.Topology.GraphSpanningTreeLoopQuotientInjectiveG3
import HolomorphicAnosov.Topology.RootedEdgeLoopCollapse
import HolomorphicAnosov.Topology.SignedWordClosure
import HolomorphicAnosov.Topology.GraphSpanningTreeLoopFundamentalWordMapG3
import Mathlib.Analysis.Convex.Contractible

open _root_.Topology
namespace HolomorphicAnosov

/-- Every graph loop is a finite signed word in the specified non-tree edge loops.

Source: Hatcher, Algebraic Topology, Lemma 1.15 p.35, Proposition 1A.2
pp.84–85, and the spanning-tree quotient of Proposition 0.17 pp.15–16.
Proof: the quotient presentation gives open embedded complementary-edge interiors.
Together with the outer-half collar these cover the quotient. The explicit collar
contraction fixes its root and supplies root paths lifting inside each interval.
Apply finite subdivision to a loop and insert those root paths at the junctions.
Adjacent connector factors cancel. A collar loop contracts, while a path in an
edge interior lifts to its simply connected characteristic interval. Joining its
two root-path lifts gives a path between the marked interval endpoints, hence the
edge loop, its reverse, or the constant loop. Therefore every quotient loop lies
in the subgroup generated by the characteristic edge loops.

Both original tree-root paths collapse to constants, so the original specified
generator maps to the characteristic traversal with precisely its given Boolean
orientation. The collapse map is injective on fundamental groups. Expand subgroup
membership into a finite signed list and pull its equality back through this
injection. No finiteness, countability, or local-finiteness assumption is used.
The interval lifting and endpoint bookkeeping are an agent-written expansion of
the published compact-subdivision argument.
-/
theorem graph_spanning_tree_loop_compact_subdivision_nonempty_word_g3
    {X : Type*} [TopologicalSpace X] [T2Space X] [ConnectedSpace X]
    [CWComplex (Set.univ : Set X)]
    (hdim : ∀ n : ℕ, 1 < n → IsEmpty (RelCWComplex.cell (Set.univ : Set X) n))
    (T : RelCWComplex.Subcomplex (Set.univ : Set X))
    (hT0 : T.I 0 = Set.univ)
    (hTsimple : ((CWComplex.OneSkeletonGraph (Set.univ : Set X)).restrict (T.I 1)).Simple)
    (hTtree : ((CWComplex.OneSkeletonGraph (Set.univ : Set X)).restrict (T.I 1)).toSimpleGraph.IsTree)
    (v0 : RelCWComplex.cell (Set.univ : Set X) 0)
    (u v : RelCWComplex.cell (Set.univ : Set X) 1 → RelCWComplex.cell (Set.univ : Set X) 0)
    (rev : RelCWComplex.cell (Set.univ : Set X) 1 → Bool)
    (edgePath : ∀ e, Path (RelCWComplex.map (C := Set.univ) 0 (u e) ![])
      (RelCWComplex.map (C := Set.univ) 0 (v e) ![]))
    (hedge : ∀ e t, edgePath e t = RelCWComplex.map (C := Set.univ) 1 e
      (fun _ ↦ if rev e then 1 - 2 * (t : ℝ) else 2 * (t : ℝ) - 1))
    (q : ∀ w, Path (RelCWComplex.map (C := Set.univ) 0 v0 ![])
      (RelCWComplex.map (C := Set.univ) 0 w ![]))
    (hq : ∀ w t, q w t ∈ (T : Set X))
    (hE : ∃ e : RelCWComplex.cell (Set.univ : Set X) 1, e ∉ T.I 1) :
    let pt := fun w : RelCWComplex.cell (Set.univ : Set X) 0 ↦ RelCWComplex.map (C := Set.univ) 0 w ![]
    let E := {e : RelCWComplex.cell (Set.univ : Set X) 1 // e ∉ T.I 1}
    let generator : E → FundamentalGroup X (pt v0) := fun e ↦ FundamentalGroup.fromPath
      (Path.Homotopic.Quotient.mk (((q (u e)).trans (edgePath e)).trans (q (v e)).symm))
    ∀ α : FundamentalGroup X (pt v0), ∃ word : List (E × Bool),
      α = (word.map (fun letter ↦ if letter.2 then generator letter.1 else
        (generator letter.1)⁻¹)).prod := by
  classical
  dsimp only
  let pt := fun w : RelCWComplex.cell (Set.univ : Set X) 0 ↦ RelCWComplex.map 0 w ![]
  let E := {e : RelCWComplex.cell (Set.univ : Set X) 1 // e ∉ T.I 1}
  let generator : E → FundamentalGroup X (pt v0) := fun e ↦ FundamentalGroup.fromPath
    (Path.Homotopic.Quotient.mk (((q (u e)).trans (edgePath e)).trans (q (v e)).symm))
  intro α
  let a : (T : Set X) := ⟨pt v0, by
    apply T.closedCell_subset_of_mem (by rw [hT0]; trivial)
    exact ⟨(![] : Fin 0 → ℝ), by simp, rfl⟩⟩
  let D := Metric.closedBall (0 : Fin 1 → ℝ) 1
  let W := GoodPair.Collapsed (T : Set X)
  let f := GoodPair.collapse (T : Set X)
  let b : W := f (pt v0)
  let π : Unit ⊕ (Σ _ : E, D) → W :=
    Sum.elim (fun _ ↦ b) (fun p ↦ f (RelCWComplex.map 1 p.1.val p.2.val))
  let χ (e : E) : C(D, W) :=
    ⟨fun z ↦ f (RelCWComplex.map 1 e.val z.val),
      f.continuous.comp (RelCWComplex.continuousOn 1 e.val).domRestrict⟩
  obtain ⟨hπ, hroot, hinj⟩ :=
    graph_spanning_tree_loop_quotient_presentation_data_g3 hdim T hT0 a
  change IsQuotientMap π at hπ
  change ∀ e z, χ e z = b ↔ ‖z.val‖ = 1 at hroot
  change ∀ e g z w, ‖z.val‖ < 1 → ‖w.val‖ < 1 →
    (χ e z = χ g w ↔ e = g ∧ z = w) at hinj
  obtain ⟨V, U, hopenV, _hopenU, _hUcover, _hpath, _hinterior, hV,
    hb, H, hH0, hH1, hHb, _hHmem, G, hG0, hG1, hGb, hGmem, hGlift⟩ :=
    graph_spanning_tree_loop_collapsed_wedge_collar_cover_g3 hdim T hT0 a hE
  change Set W at V
  change ∀ e z, χ e z ∈ V ↔ 1 / 2 < ‖z.val‖ at hV
  let lo : D := ⟨fun _ ↦ -1, by simp [D, Metric.mem_closedBall, dist_zero_right]⟩
  let hi : D := ⟨fun _ ↦ 1, by simp [D, Metric.mem_closedBall, dist_zero_right]⟩
  have hlo (e : E) : χ e lo = b := (hroot e lo).mpr (by simp [lo])
  have hhi (e : E) : χ e hi = b := (hroot e hi).mpr (by simp [hi])
  have hnorm (z : Fin 1 → ℝ) : ‖z‖ = |z 0| := by
    have hz : z = fun _ ↦ z 0 := by ext i; congr 1; exact Fin.eq_zero i
    rw [hz]; simp
  let edge : Path lo hi :=
    { toFun := fun t ↦ ⟨fun _ ↦ 2 * (t : ℝ) - 1, by
        rw [Metric.mem_closedBall, dist_zero_right, hnorm, abs_le]
        constructor <;> linarith [t.property.1, t.property.2]⟩
      continuous_toFun := by apply Continuous.subtype_mk; fun_prop
      source' := by apply Subtype.ext; funext i; norm_num
      target' := by apply Subtype.ext; funext i; norm_num }
  let A : Set D := {z | ‖z.val‖ < 1}
  have hemb (e : E) : IsOpenEmbedding (fun z : A ↦ χ e z.val) := by
    let j : A → Unit ⊕ (Σ _ : E, D) := fun z ↦ .inr ⟨e, z.val⟩
    have hj : IsOpenEmbedding j := IsOpenEmbedding.inr.comp
      (IsOpenEmbedding.sigmaMk.comp
        ((isOpen_lt (continuous_norm.comp continuous_subtype_val) continuous_const).isOpenEmbedding_subtypeVal))
    apply quotient_open_embedding_of_singleton_fibres_g3 hπ hj
    intro z r heq
    cases r with
    | inl u =>
      have hz : χ e z.val = b := heq.symm
      exact False.elim (ne_of_lt z.property ((hroot e z.val).mp hz))
    | inr r =>
      obtain ⟨g, w⟩ := r
      have hw : ‖w.val‖ < 1 := by
        have hle : ‖w.val‖ ≤ 1 := by simpa only [D, Metric.mem_closedBall, dist_zero_right] using w.property
        apply lt_of_le_of_ne hle
        intro hw
        have hz : χ e z.val = b := heq.symm.trans ((hroot g w).mpr hw)
        exact ne_of_lt z.property ((hroot e z.val).mp hz)
      obtain ⟨he, hw⟩ := (hinj g e w z.val hw z.property).mp heq
      subst g
      rw [hw]
  have hcover : ∀ y, y ∈ V ∨ ∃ e, y ∈ Set.range (fun z : A ↦ χ e z.val) := by
    intro y
    obtain ⟨r, rfl⟩ := hπ.surjective y
    cases r with
    | inl u => exact Or.inl hb
    | inr r =>
      obtain ⟨e, z⟩ := r
      by_cases hz : ‖z.val‖ < 1
      · exact Or.inr ⟨e, ⟨⟨z, hz⟩, rfl⟩⟩
      · left
        have hle : ‖z.val‖ ≤ 1 := by simpa only [D, Metric.mem_closedBall, dist_zero_right] using z.property
        have he := (hroot e z).mpr (le_antisymm hle (le_of_not_gt hz))
        change χ e z ∈ V
        rw [he]; exact hb
  have hGlift' : ∀ e z, ∃ v, (v = lo ∨ v = hi) ∧
      ∃ l : Path z v, ∀ t, G (χ e z) t = χ e (l t) := by
    intro e z
    obtain ⟨w, hw, l, hl⟩ := hGlift e z
    refine ⟨w, hw.elim (fun h ↦ Or.inl (Subtype.ext h))
      (fun h ↦ Or.inr (Subtype.ext h)), l, hl⟩
  have : ContractibleSpace D := (convex_closedBall (0 : Fin 1 → ℝ) 1).contractibleSpace
    ⟨0, by simp⟩
  let φ : FundamentalGroup X (pt v0) →* FundamentalGroup W b := FundamentalGroup.map f (pt v0)
  let K := Subgroup.closure (Set.range (fun e : E ↦ φ (generator e)))
  have hedgeK : ∀ e, FundamentalGroup.fromPath
      (Path.Homotopic.Quotient.mk ((edge.map (χ e).continuous).cast (hlo e).symm (hhi e).symm)) ∈ K := by
    intro e
    have hcollapse (x : X) (hx : x ∈ (T : Set X)) : f x = b :=
      Quotient.sound (Or.inr ⟨hx, a.property⟩)
    have hpt (w) : f (pt w) = b := by
      have hw := hcollapse (q w 1) (hq w 1)
      simpa only [Path.target] using hw
    have hφ : φ (generator e) = FundamentalGroup.fromPath
        (Path.Homotopic.Quotient.mk (((edgePath e).map f.continuous).cast
          (hpt (u e)).symm (hpt (v e)).symm)) := by
      have hm := Topology.mapOfEq_rooted_edge_loop_of_constant_root_paths f (pt v0)
        (pt (u e)) (pt (v e)) b rfl (hpt (u e)) (hpt (v e))
        (q (u e)) (q (v e)) (edgePath e)
        (fun t ↦ hcollapse _ (hq _ t)) (fun t ↦ hcollapse _ (hq _ t))
      rw [FundamentalGroup.mapOfEq_apply, Path.Homotopic.Quotient.cast_rfl_rfl] at hm
      exact hm
    let canonical : Path b b := (edge.map (χ e).continuous).cast (hlo e).symm (hhi e).symm
    have horient : ((edgePath e).map f.continuous).cast
        (hpt (u e)).symm (hpt (v e)).symm =
        if rev e then canonical.symm else canonical := by
      cases hrev : rev e with
      | false =>
        simp only [Bool.false_eq_true, ite_false]
        ext t
        change f (edgePath e t) = f (RelCWComplex.map 1 e.val (fun _ ↦ 2 * (t : ℝ) - 1))
        rw [hedge]
        simp only [hrev, Bool.false_eq_true, ite_false]
      | true =>
        simp only [ite_true]
        ext t
        change f (edgePath e t) = f (RelCWComplex.map 1 e.val
          (fun _ ↦ 2 * (unitInterval.symm t : ℝ) - 1))
        rw [hedge]
        simp only [hrev, ite_true, unitInterval.coe_symm_eq]
        congr 2
        funext i
        ring
    have hmem : φ (generator e) ∈ K := Subgroup.subset_closure ⟨e, rfl⟩
    rw [hφ, horient] at hmem
    cases hrev : rev e with
    | false =>
      simpa only [hrev, Bool.false_eq_true, ite_false] using hmem
    | true =>
      simp only [hrev, ite_true] at hmem
      change (FundamentalGroup.fromPath (Path.Homotopic.Quotient.mk canonical))⁻¹ ∈ K at hmem
      simpa only [inv_inv] using K.inv_mem hmem
  have hα : φ α ∈ K := by
    induction φ α using Quotient.inductionOn with
    | h γ =>
      exact interval_wedge_loop_subgroup_g3 χ lo hi b hlo hhi edge A hemb V hopenV hb hcover
        H hH0 hH1 hHb G hG0 hG1 hGb hGmem hGlift' K hedgeK γ
  obtain ⟨word, hw⟩ := Topology.exists_signed_word_of_mem_subgroup_closure
    (fun e : E ↦ φ (generator e)) hα
  refine ⟨word, ?_⟩
  apply graph_spanning_tree_loop_compact_subdivision_quotient_injective_g3 hdim T hT0 hTsimple hTtree v0
  change φ α = φ _
  rw [Topology.graph_spanning_tree_loop_fundamental_word_map_g3 φ generator word]
  exact hw

end HolomorphicAnosov
