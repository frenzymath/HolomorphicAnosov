import HolomorphicAnosov.Geometry.ComplexModel
import HolomorphicAnosov.Topology.PointedPathClassUniversalCover
import Mathlib.Analysis.Convex.Contractible
import Mathlib.Geometry.Manifold.ChartedSpace
import Mathlib.Topology.OpenPartialHomeomorph.Basic
import Mathlib.AlgebraicTopology.FundamentalGroupoid.SimplyConnected

/-!
# Pointed universal covers of spaces with complex charts

DAG node: `topo.pointed_universal_cover_of_complex_charts_g11`.
Source: Hatcher, Algebraic Topology, pp.63–65, explicit based-path universal
cover construction. Complex chart balls supply the local hypotheses.
-/

namespace HolomorphicAnosov.Proposition29Cover

universe u
open Set
open scoped Topology _root_.Topology ContDiff Manifold

/-- The endpoint-indexed path-homotopy classes of a connected Hausdorff space
with complex coordinate charts admit a simply connected covering topology.
The topology is existentially supplied on the literal sigma carrier, and is
not asserted to be its disjoint-union topology.

Source: Hatcher, Algebraic Topology, pp.63–65.

Natural-language proof: At each point x choose a positive-radius open ball
centered at the image of x in the target of its preferred chart and contained
in that target. The ball is convex and nonempty, hence contractible. Restrict
the inverse chart to this ball; it is a homeomorphism onto an open neighborhood
of x. This neighborhood is simply connected, so every loop with image there
has a nullhomotopy there and therefore also in X. The chart atlas also gives
local path connectedness, and connectedness then gives path connectedness.
Apply the pointed path-class universal-cover theorem to the chosen basepoint
and these local loop contractions. Choose its topology generated by sheets:
over a path-connected open set with trivial ambient loop classes, a sheet
consists of path classes obtained by appending paths inside that set to a
fixed based path class. That theorem supplies simple connectedness of the
covering space and the covering property of endpoint projection. Its projection
is surjective because every point of X can be joined to b by a path. The same
argument works in dimension zero: a positive-radius ball in the zero model
is the singleton model. No positive dimension, complex smoothness, compactness,
or Euclidean universal-cover identification is required. -/
theorem pointed_universal_cover_of_complex_charts
    {d : ℕ} {X : Type u} [TopologicalSpace X] [ChartedSpace (ComplexModel d) X]
    [T2Space X] [ConnectedSpace X] (b : X) :
    let E := Σ x : X, Path.Homotopic.Quotient b x
    ∃ t : TopologicalSpace E, letI := t
      SimplyConnectedSpace E ∧ IsCoveringMap (fun e : E ↦ e.1) ∧
        Function.Surjective (fun e : E ↦ e.1) := by
  have hsemi : ∀ x : X, ∃ U : Set X, IsOpen U ∧ x ∈ U ∧
      ∀ p : Path x x, (∀ t, p t ∈ U) → p.Homotopic (Path.refl x) := by
    intro x
    let e := chartAt (ComplexModel d) x
    obtain ⟨r, hr, hball⟩ := Metric.isOpen_iff.mp e.open_target (e x)
      (mem_chart_target (ComplexModel d) x)
    let B := Metric.ball (e x) r
    have : ContractibleSpace B := (convex_ball (e x) r).contractibleSpace
      ⟨e x, Metric.mem_ball_self hr⟩
    let H : B ≃ₜ (e.symm '' B) :=
      e.symm.homeomorphOfImageSubsetSource hball rfl
    have hU : IsSimplyConnected (e.symm '' B) :=
      H.symm.toHomotopyEquiv.simplyConnectedSpace
    refine ⟨e.symm '' B, e.symm.isOpen_image_of_subset_source Metric.isOpen_ball hball,
      ⟨e x, Metric.mem_ball_self hr, e.left_inv (mem_chart_source _ x)⟩, ?_⟩
    intro p hp
    obtain ⟨F, _⟩ := (isSimplyConnected_iff_exists_homotopy_refl_forall_mem.mp hU).2 x p hp
    exact ⟨F⟩
  have : LocallyPathConnectedSpace X :=
    ChartedSpace.locallyPathConnectedSpace (ComplexModel d) X
  have : PathConnectedSpace X := pathConnectedSpace_iff_connectedSpace.mpr inferInstance
  let E := Σ x : X, Path.Homotopic.Quotient b x
  let good : Set X → Prop := fun V ↦ IsOpen V ∧ IsPathConnected V ∧
    ∀ x : X, x ∈ V → ∀ p : Path x x,
      (∀ t, p t ∈ V) → p.Homotopic (Path.refl x)
  let sheet : Set X → E → Set E := fun V z ↦
    {e | ∃ η : Path z.1 e.1, (∀ t, η t ∈ V) ∧
      z.2.trans (Path.Homotopic.Quotient.mk η) = e.2}
  let t : TopologicalSpace E := TopologicalSpace.generateFrom
    {S | ∃ (V : Set X) (z : E), good V ∧ z.1 ∈ V ∧ S = sheet V z}
  obtain ⟨hsurj, hcover, _, hsimply, _⟩ := pointed_path_class_universal_cover b hsemi
  exact ⟨t, hsimply, hcover, hsurj⟩


end HolomorphicAnosov.Proposition29Cover
