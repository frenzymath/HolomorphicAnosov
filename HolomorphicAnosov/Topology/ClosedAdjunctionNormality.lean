import HolomorphicAnosov.Topology.ClosedAdjunctionRealTietzeExtension
import Mathlib.Topology.Compactness.CompactlyGeneratedSpace
import Mathlib.Topology.Constructions
import Mathlib.Topology.UnitInterval

/-!
# Normality of a closed adjunction: the Tietze extension step

Source: Fritsch--Piccinini, *Cellular Structures in Topology* (1990), Appendix A.4,
closed cofibrations pp.250--251, ordinary adjunction topology pp.258--259, and
Proposition A.4.8(iv), including its normality proof, pp.260--261.
DAG node: `topo.closed_adjunction_normality_g7`.

The inclusion's homotopy extension property is written out explicitly. The quotient
uses Mathlib's ordinary coinduced topology on `Quot`, without kification or a
Hausdorff reflection. The relation identifies each attaching point with its image;
`Quot` imposes the equivalence relation generated by these identifications.
-/

namespace HolomorphicAnosov

universe u

/-- A closed-cofibration adjunction of compactly generated Hausdorff normal spaces
is normal, with the original quotient topology.

Source: Fritsch--Piccinini, Appendix A.4, Proposition A.4.8(iv), pp.260--261.
The closed-cofibration hypothesis is exactly closedness of `D` together with the
homotopy extension property displayed below: every continuous homotopy on `D`
whose initial map extends to `Y` extends to a homotopy on `Y` with that same initial
map. Target spaces of the homotopy extension property range over the same universe
as the spaces being attached. This is the ordinary universe-polymorphic topological
notion; no categorical choice of a class of cofibrations is substituted.

Proof: Write `i : A → Z` and `j : Y → Z` for the continuous canonical
maps into the ordinary quotient. For disjoint closed `s,t ⊆ Z`, Urysohn's lemma
on `A` gives a continuous real-valued `g` equal to zero on `i ⁻¹' s` and one
on `i ⁻¹' t`. Tietze extension extends `g ∘ alpha` from the closed set `D`
to a continuous `v : Y → ℝ`. Put `S = j ⁻¹' s` and `T = j ⁻¹' t`.
Define `w` to equal zero on `S`, one on `T`, and `v` elsewhere. On `D`,
this agrees with `v`: the seam equation `j d = i (alpha d)` and the defining
values of `g` prove agreement on both overlaps. Thus `w` is continuous on
each of the three closed sets `D,S,T`, and closed pasting gives continuity
on their union. A second Tietze extension gives a continuous `h : Y → ℝ`
agreeing with `w` on the union. In particular `h d = g (alpha d)`.

The continuous coproduct map with branches `g,h` respects each generating
identification, so it descends continuously to `u : Z → ℝ`. Quotient
induction shows that `u` equals zero on `s` and one on `t`. The inverse
images of `(-∞,1/2)` and `(1/2,∞)` are disjoint open neighborhoods of `s,t`.
This proves normality, including when either closed set or either attaching
space is empty. The cofibration and ambient hypotheses from the source are
retained; this normality argument itself only uses closedness and normality.
-/
theorem closed_adjunction_normality
    {A Y : Type u} [TopologicalSpace A] [TopologicalSpace Y]
    [CompactlyGeneratedSpace A] [CompactlyGeneratedSpace Y]
    [T2Space A] [T2Space Y] [NormalSpace A] [NormalSpace Y]
    (D : Set Y) (hD : IsClosed D)
    (_h_cofibration : ∀ (T : Type u) [TopologicalSpace T]
      (g : Y → T) (h : unitInterval × D → T),
      Continuous g → Continuous h →
      (∀ d : D, h (0, d) = g d) →
      ∃ H : unitInterval × Y → T,
        Continuous H ∧ (∀ y, H (0, y) = g y) ∧
          ∀ (t : unitInterval) (d : D), H (t, d) = h (t, d))
    (alpha : D → A) (h_alpha : Continuous alpha) :
    let r : (A ⊕ Y) → (A ⊕ Y) → Prop := fun p q ↦
      ∃ d : D, p = Sum.inr (d : Y) ∧ q = Sum.inl (alpha d)
    NormalSpace (Quot r) := by
  classical
  dsimp only
  let r : (A ⊕ Y) → (A ⊕ Y) → Prop := fun p q ↦
    ∃ d : D, p = Sum.inr (d : Y) ∧ q = Sum.inl (alpha d)
  let q : (A ⊕ Y) → Quot r := Quot.mk r
  let i : A → Quot r := fun a ↦ q (Sum.inl a)
  let j : Y → Quot r := fun y ↦ q (Sum.inr y)
  have hi : Continuous i := continuous_quot_mk.comp continuous_inl
  have hj : Continuous j := continuous_quot_mk.comp continuous_inr
  have seam (d : D) : j d = i (alpha d) := Quot.sound ⟨d, rfl, rfl⟩
  refine ⟨fun s t hs ht hst ↦ ?_⟩
  obtain ⟨g, hgs, hgt, _⟩ := exists_continuous_zero_one_of_isClosed
    (hs.preimage hi) (ht.preimage hi) (hst.preimage i)
  let f : C(D, ℝ) := ⟨fun d ↦ g (alpha d), g.continuous.comp h_alpha⟩
  obtain ⟨v, hv⟩ := exists_continuous_real_extension_of_closed D hD f
  have hvD (d : D) : v d = g (alpha d) := congrArg (fun k : C(D, ℝ) ↦ k d) hv
  let S : Set Y := j ⁻¹' s
  let T : Set Y := j ⁻¹' t
  have hS : IsClosed S := hs.preimage hj
  have hT : IsClosed T := ht.preimage hj
  have hST : Disjoint S T := hst.preimage j
  let w : Y → ℝ := fun y ↦ if y ∈ S then 0 else if y ∈ T then 1 else v y
  have hwS : Set.EqOn w (fun _ ↦ 0) S := by
    intro y hy
    simp [w, hy]
  have hwT : Set.EqOn w (fun _ ↦ 1) T := by
    intro y hy
    have hn : y ∉ S := fun h ↦ Set.disjoint_left.mp hST h hy
    simp [w, hn, hy]
  have hwD : Set.EqOn w v D := by
    intro y hy
    have hyD := hvD ⟨y, hy⟩
    dsimp [w]
    split_ifs with hyS hyT
    · rw [hyD]
      symm
      apply hgs
      change i (alpha ⟨y, hy⟩) ∈ s
      rw [← seam ⟨y, hy⟩]
      exact hyS
    · rw [hyD]
      symm
      apply hgt
      change i (alpha ⟨y, hy⟩) ∈ t
      rw [← seam ⟨y, hy⟩]
      exact hyT
    · rfl
  have hwCont : ContinuousOn w (D ∪ S ∪ T) :=
    ((v.continuous.continuousOn.congr hwD).union_of_isClosed
      (continuousOn_const.congr hwS) hD hS).union_of_isClosed
        (continuousOn_const.congr hwT) (hD.union hS) hT
  let w' : C(↥(D ∪ S ∪ T), ℝ) := ⟨_, continuousOn_iff_continuous_domRestrict.mp hwCont⟩
  obtain ⟨h, hh⟩ := exists_continuous_real_extension_of_closed
    (D ∪ S ∪ T) ((hD.union hS).union hT) w'
  have hhE (y : Y) (hy : y ∈ D ∪ S ∪ T) : h y = w y :=
    congrArg (fun k : C(↥(D ∪ S ∪ T), ℝ) ↦ k ⟨y, hy⟩) hh
  have hhD (d : D) : h d = g (alpha d) :=
    (hhE d (Or.inl (Or.inl d.property))).trans ((hwD d.property).trans (hvD d))
  let F : A ⊕ Y → ℝ := Sum.elim g h
  have hF : Continuous F := g.continuous.sumElim h.continuous
  have hrel : ∀ a b, r a b → F a = F b := by
    rintro a b ⟨d, rfl, rfl⟩
    exact hhD d
  let u : Quot r → ℝ := Quot.lift F hrel
  have hu : Continuous u := continuous_quot_lift hrel hF
  have hus : Set.EqOn u (fun _ ↦ 0) s := by
    intro z hz
    induction z using Quot.inductionOn with
    | h p =>
      cases p with
      | inl a => exact hgs hz
      | inr y => exact (hhE y (Or.inl (Or.inr hz))).trans (hwS hz)
  have hut : Set.EqOn u (fun _ ↦ 1) t := by
    intro z hz
    induction z using Quot.inductionOn with
    | h p =>
      cases p with
      | inl a => exact hgt hz
      | inr y => exact (hhE y (Or.inr hz)).trans (hwT hz)
  refine ⟨u ⁻¹' Set.Iio (1 / 2), u ⁻¹' Set.Ioi (1 / 2),
    isOpen_Iio.preimage hu, isOpen_Ioi.preimage hu, ?_, ?_, ?_⟩
  · intro z hz
    change u z < (1 / 2 : ℝ)
    rw [hus hz]
    norm_num
  · intro z hz
    change (1 / 2 : ℝ) < u z
    rw [hut hz]
    norm_num
  · exact Set.disjoint_left.mpr fun z hz hz' ↦ (not_lt_of_gt (show u z < (1 / 2 : ℝ) from hz)) (show (1 / 2 : ℝ) < u z from hz')

end HolomorphicAnosov
