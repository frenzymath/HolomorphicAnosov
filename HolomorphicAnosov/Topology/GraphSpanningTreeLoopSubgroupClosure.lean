open _root_.Topology

namespace HolomorphicAnosov

/-- Every based loop class lies in the subgroup generated by the characteristic
non-tree edge loops after collapsing the rooted tree.

Source: Hatcher, *Algebraic Topology*, Proposition 1A.2, pp.84--85. The
rooted contraction of Proposition 1A.1 and the quotient presentation of the
same pages identify the graph quotient with the one-vertex wedge of circles;
compactness of a loop parameter and finite subdivision reduce a loop to finitely
many circle traversals. This named interface records that topological part so
that the final finite signed-word conversion is handled separately by
`exists_signed_word_of_mem_subgroup_closure`. The omitted proof is the source
argument just described and is intentionally a named theorem for later repair.
-/
theorem graph_spanning_tree_loop_subgroup_closure
    {X : Type*} [TopologicalSpace X] [T2Space X] [ConnectedSpace X]
    [CWComplex (Set.univ : Set X)]
    (hdim : ∀ n : ℕ, 1 < n → IsEmpty (RelCWComplex.cell (Set.univ : Set X) n))
    (T : RelCWComplex.Subcomplex (Set.univ : Set X))
    (hT0 : T.I 0 = Set.univ)
    (hTsimple : ((CWComplex.OneSkeletonGraph (Set.univ : Set X)).restrict (T.I 1)).Simple)
    (hTtree :
      ((CWComplex.OneSkeletonGraph (Set.univ : Set X)).restrict (T.I 1)).toSimpleGraph.IsTree)
    (v0 : RelCWComplex.cell (Set.univ : Set X) 0) :
    let pt := fun v : RelCWComplex.cell (Set.univ : Set X) 0 ↦
      RelCWComplex.map (C := Set.univ) 0 v ![]
    ∀ (u v : RelCWComplex.cell (Set.univ : Set X) 1 →
        RelCWComplex.cell (Set.univ : Set X) 0)
      (rev : RelCWComplex.cell (Set.univ : Set X) 1 → Bool)
      (edgePath : ∀ e, Path (pt (u e)) (pt (v e))),
      (∀ e t, edgePath e t = RelCWComplex.map (C := Set.univ) 1 e
        (fun _ ↦ if rev e then 1 - 2 * (t : ℝ) else 2 * (t : ℝ) - 1)) →
      ∀ (q : ∀ w, Path (pt v0) (pt w)),
        (∀ w t, q w t ∈ (T : Set X)) →
        let generator : {e : RelCWComplex.cell (Set.univ : Set X) 1 // e ∉ T.I 1} →
            FundamentalGroup X (pt v0) := fun e ↦
          FundamentalGroup.fromPath (Path.Homotopic.Quotient.mk
            (((q (u e)).trans (edgePath e)).trans (q (v e)).symm))
        ∀ α : FundamentalGroup X (pt v0),
          α ∈ Subgroup.closure (Set.range generator) := by
  exact graph_spanning_tree_loop_compact_subdivision hdim T hT0 hTsimple hTtree v0

end HolomorphicAnosov
