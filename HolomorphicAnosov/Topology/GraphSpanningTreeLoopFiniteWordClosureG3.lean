import HolomorphicAnosov.Topology.SignedWordClosure

namespace HolomorphicAnosov.Topology

/-- A finite signed-word certificate obtained from the compact weak-wedge
subdivision lies in the subgroup generated by the characteristic edge loops.

Source: Hatcher, *Algebraic Topology*, Proposition 1A.2, pp.84--85.  The
geometric quotient argument supplies the finite word; this helper performs the
remaining algebraic conversion explicitly and is independent of injectivity or
finiteness of the edge index type.
-/
theorem graph_spanning_tree_loop_finite_word_closure_g3
    {G E : Type*} [Group G] (generator : E → G)
    (eval : List (E × Bool) → G)
    (heval : eval [] = 1 ∧
      (∀ a w, eval (a :: w) =
        (if a.2 then generator a.1 else (generator a.1)⁻¹) * eval w) )
    {x : G} (hx : ∃ w : List (E × Bool), x = eval w) :
    x ∈ Subgroup.closure (Set.range generator) := by
  obtain ⟨w, rfl⟩ := hx
  induction w with
  | nil =>
      rw [heval.1]
      exact Subgroup.one_mem _
  | cons a w ih =>
      have hsplit : eval (a :: w) =
          (if a.2 then generator a.1 else (generator a.1)⁻¹) * eval w :=
        heval.2 a w
      rw [hsplit]
      cases a.2 <;> simp
      · exact Subgroup.mul_mem _
          (Subgroup.inv_mem _ (Subgroup.subset_closure ⟨a.1, rfl⟩)) ih
      · exact Subgroup.mul_mem _ (Subgroup.subset_closure ⟨a.1, rfl⟩) ih

end HolomorphicAnosov.Topology
