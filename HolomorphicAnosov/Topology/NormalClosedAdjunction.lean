import HolomorphicAnosov.Topology.ClosedAdjunctionNormality

/-!
# Normality of a closed adjunction

Source: Fritsch--Piccinini, *Cellular Structures in Topology* (1990), Appendix A.4,
closed cofibrations pp.250--251, ordinary adjunction topology pp.258--259, and
Proposition A.4.8(iv), including its normality proof, pp.260--261.
DAG node: `topo.normal_closed_adjunction_g8`.

The inclusion's homotopy extension property is written out explicitly. The quotient
uses Mathlib's ordinary coinduced topology on `Quot`, without kification or a
Hausdorff reflection. The relation identifies each attaching point with its image;
`Quot` imposes the equivalence relation generated by these identifications.
-/

open Set

namespace HolomorphicAnosov

universe u

/-- A closed-cofibration adjunction of compactly generated Hausdorff normal spaces
is normal and Hausdorff, with the original quotient topology.

Source: Fritsch--Piccinini, Appendix A.4, Proposition A.4.8(iv), pp.260--261.
The closed-cofibration hypothesis is exactly closedness of `D` together with the
homotopy extension property displayed below: every continuous homotopy on `D`
whose initial map extends to `Y` extends to a homotopy on `Y` with that same initial
map. Target spaces of the homotopy extension property range over the same universe
as the spaces being attached. This is the ordinary universe-polymorphic topological
notion; no categorical choice of a class of cofibrations is substituted.

Proof: Write `Z` for the quotient and `i : A → Z`, `j : Y → Z` for its canonical
maps. Both maps are continuous by the coinduced quotient topology. Closedness of
`D` and the homotopy extension property are retained from the source's closed
cofibration hypothesis; the following normality argument only needs closedness.
Given a closed subset `C` of `Z` and a continuous interval-valued map `k` on `C`,
its pullback `C_A` under `i` is closed. Tietze extension in normal `A` extends
`k ∘ i` to a continuous map `g : A → [0,1]`. The pullback `C_Y` under `j` is also
closed. On the closed subset `C_Y ∪ D` of `Y`, prescribe `k ∘ j` on `C_Y` and
`g ∘ alpha` on `D`. These prescriptions agree on their intersection, since
`j(d) = i(alpha(d))` and `g` extends `k` there. Finite closed pasting makes this
prescription continuous. Tietze extension in normal `Y` gives a continuous map
`h : Y → [0,1]` agreeing with both prescriptions.

The continuous coproduct map with restrictions `g` and `h` respects every generating
identification, hence its generated equivalence relation. Quotient descent gives a
continuous map on `Z` extending `k`; every point of `C` has an `A` or `Y`
representative, so the extension agrees on all of `C`. For disjoint closed subsets
`F,G` of `Z`, finite closed pasting gives the interval-valued function equal to zero
on `F` and one on `G`. Extend it as above. The inverse images of the relatively
open intervals `[0,1/3)` and `(2/3,1]` are disjoint open neighborhoods, proving
normality. Empty closed subsets cause no exception.

Independently, every singleton of `Z` is closed. The raw fibre of a point represented
by `a : A` consists of its singleton in `A` and the closed subset
`alpha⁻¹({a})` of `D`, which is closed in `Y`. The fibre of a point represented by
`y ∉ D` is its singleton in the `Y` summand. Hausdorffness of `A,Y` and continuity
of `alpha` give these closed fibres, including noninjective attaching maps. By the
quotient topology each singleton of `Z` is closed. Normality then separates any
two distinct singleton sets, proving Hausdorffness. This argument never assumes
separation of `Z` before proving it. If `D` is empty the quotient is the coproduct;
if `A` is empty the given attaching map forces `D` empty. No compactness, dimension,
countability, nonemptiness, or injectivity assumption is used.
-/
theorem normal_closed_adjunction
    {A Y : Type u} [TopologicalSpace A] [TopologicalSpace Y]
    [CompactlyGeneratedSpace A] [CompactlyGeneratedSpace Y]
    [T2Space A] [T2Space Y] [NormalSpace A] [NormalSpace Y]
    (D : Set Y) (hD : IsClosed D)
    (h_cofibration : ∀ (T : Type u) [TopologicalSpace T]
      (g : Y → T) (h : unitInterval × D → T),
      Continuous g → Continuous h →
      (∀ d : D, h (0, d) = g d) →
      ∃ H : unitInterval × Y → T,
        Continuous H ∧ (∀ y, H (0, y) = g y) ∧
          ∀ (t : unitInterval) (d : D), H (t, d) = h (t, d))
    (alpha : D → A) (h_alpha : Continuous alpha) :
    let r : (A ⊕ Y) → (A ⊕ Y) → Prop := fun p q ↦
      ∃ d : D, p = Sum.inr (d : Y) ∧ q = Sum.inl (alpha d)
    NormalSpace (Quot r) ∧ T2Space (Quot r) := by
  classical
  let r : (A ⊕ Y) → (A ⊕ Y) → Prop := fun p q ↦
    ∃ d : D, p = Sum.inr (d : Y) ∧ q = Sum.inl (alpha d)
  change NormalSpace (Quot r) ∧ T2Space (Quot r)
  let N : A ⊕ Y → A ⊕ Y := Sum.elim Sum.inl
    (fun y ↦ if hy : y ∈ D then Sum.inl (alpha ⟨y, hy⟩) else Sum.inr y)
  have hN : ∀ p q, r p q → N p = N q := by
    rintro p q ⟨d, rfl, rfl⟩
    simp [N, d.property]
  let f : Quot r → A ⊕ Y := Quot.lift N hN
  have hmk : ∀ p, Quot.mk r (N p) = Quot.mk r p := by
    intro p
    cases p with
    | inl a => rfl
    | inr y =>
      by_cases hy : y ∈ D
      · simp only [N, Sum.elim_inr, dite_eq_left hy]
        exact (Quot.sound ⟨⟨y, hy⟩, rfl, rfl⟩).symm
      · simp [N, hy]
  have heq (p q : A ⊕ Y) : Quot.mk r p = Quot.mk r q ↔ N p = N q := by
    constructor
    · exact fun h ↦ congrArg f h
    · intro h
      rw [← hmk p, ← hmk q, h]
  have hA (a : A) : IsClosed ({Quot.mk r (Sum.inl a)} : Set (Quot r)) := by
    apply isQuotientMap_quot_mk.isCoinducing.isClosed_preimage.mp
    apply isClosed_sum_iff.mpr
    constructor
    · convert (isClosed_singleton : IsClosed ({a} : Set A)) using 1
      ext b
      simp [heq, N]
    · have hclosed : IsClosed (Subtype.val '' (alpha ⁻¹' {a})) :=
        hD.isClosedMap_subtype_val _ (isClosed_singleton.preimage h_alpha)
      convert hclosed using 1
      ext y
      simp only [mem_preimage, mem_singleton_iff, heq]
      by_cases hy : y ∈ D
      · simp [N, hy, mem_image]
      · simp [N, hy, mem_image]
  have ht1 : T1Space (Quot r) := by
    constructor
    intro z
    induction z using Quot.inductionOn with
    | h p =>
      cases p with
      | inl a => exact hA a
      | inr y =>
        by_cases hy : y ∈ D
        · rw [show Quot.mk r (Sum.inr y) = Quot.mk r (Sum.inl (alpha ⟨y, hy⟩)) from
            Quot.sound ⟨⟨y, hy⟩, rfl, rfl⟩]
          exact hA _
        · apply isQuotientMap_quot_mk.isCoinducing.isClosed_preimage.mp
          apply isClosed_sum_iff.mpr
          constructor
          · convert (isClosed_empty : IsClosed (∅ : Set A)) using 1
            ext a
            simp [heq, N, hy]
          · convert (isClosed_singleton : IsClosed ({y} : Set Y)) using 1
            ext z
            simp only [mem_preimage, mem_singleton_iff, heq]
            by_cases hz : z ∈ D
            · simp [N, hy, hz]
              exact fun h ↦ hy (h ▸ hz)
            · simp [N, hy, hz]
  let : T1Space (Quot r) := ht1
  let : NormalSpace (Quot r) := closed_adjunction_normality D hD h_cofibration alpha h_alpha
  exact ⟨inferInstance, inferInstance⟩

end HolomorphicAnosov
