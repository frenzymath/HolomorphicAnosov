import Mathlib.Topology.ContinuousMap.Basic

namespace HolomorphicAnosov

/-- Compatible continuous cell maps descend to the quotient generated by paired faces.
Source: Hatcher, Algebraic Topology, Theorem 2A.1 proof, p.167,
`literature/hatcher-at.txt:8360–8380`. The source identifies equally parametrized
paired edges and says that the simplex maps fit together. This general quotient
argument supplies that omitted detail: evaluation on the disjoint union is continuous
because the cell labels are discrete. Compatibility gives equality on each generating
face pair. Induction on the generated equivalence relation extends that equality to
all related points; the quotient lift is then continuous and computes to each original
cell map. No finiteness, involutivity, or separation assumption is used. -/
theorem pairedCellQuotientDescent
    {I J A B X : Type*} [TopologicalSpace I] [DiscreteTopology I]
    [TopologicalSpace A] [TopologicalSpace B] [TopologicalSpace X]
    (face : J → C(B, A)) (pair : I × J → I × J) (σ : I → C(A, X))
    (hpair : ∀ o, (σ o.1).comp (face o.2) =
      (σ (pair o).1).comp (face (pair o).2)) :
    ∃ S : C(Quotient (Relation.EqvGen.setoid
      (fun x y : I × A ↦ ∃ o : I × J, ∃ t : B,
        x = (o.1, face o.2 t) ∧ y = ((pair o).1, face (pair o).2 t))), X),
      ∀ i t, S (Quotient.mk _ (i, t)) = σ i t := by
  let g : I × A → X := fun x ↦ σ x.1 x.2
  have hg : Continuous g :=
    continuous_prod_of_discrete_left.mpr (fun i ↦ (σ i).continuous)
  let r : (I × A) → (I × A) → Prop := fun x y ↦
    ∃ o : I × J, ∃ t : B,
      x = (o.1, face o.2 t) ∧ y = ((pair o).1, face (pair o).2 t)
  have respects : ∀ x y, Relation.EqvGen r x y → g x = g y := by
    intro x y h
    induction h with
    | rel x y h =>
      obtain ⟨o, t, rfl, rfl⟩ := h
      exact congrArg (fun f : C(B, X) ↦ f t) (hpair o)
    | refl x => rfl
    | symm x y h ih => exact ih.symm
    | trans x y z hxy hyz ihxy ihyz => exact ihxy.trans ihyz
  refine ⟨⟨Quotient.lift g respects, hg.quotient_lift respects⟩, ?_⟩
  intro i t
  rfl


end HolomorphicAnosov
