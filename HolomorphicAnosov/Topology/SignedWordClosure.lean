import Mathlib.Algebra.Group.Subgroup.Basic
import Mathlib.Algebra.BigOperators.Group.List.Basic

namespace HolomorphicAnosov.Topology

/-- Membership in the subgroup generated by an indexed family gives a finite signed word.

Source: the finite-word meaning of generation in Hatcher, *Algebraic Topology*,
Proposition 1A.2, pp. 84–85. This algebraic encoding is agent-written: apply subgroup
closure induction. A generator gives a singleton positive word, the identity gives
an empty word, and multiplication concatenates words. Inversion reverses the word
and flips each Boolean; the inverse-of-product formula proves its evaluation.
No injectivity, finiteness, or inhabitedness assumption on the index type is needed. -/
theorem exists_signed_word_of_mem_subgroup_closure
    {G E : Type*} [Group G] (generator : E → G) {x : G}
    (hx : x ∈ Subgroup.closure (Set.range generator)) :
    ∃ w : List (E × Bool),
      x = (w.map (fun letter ↦
        if letter.2 then generator letter.1 else (generator letter.1)⁻¹)).prod := by
  refine Subgroup.closure_induction (p := fun x _ ↦
      ∃ w : List (E × Bool),
        x = (w.map (fun letter ↦
          if letter.2 then generator letter.1 else (generator letter.1)⁻¹)).prod)
    ?_ ?_ ?_ ?_ hx
  · rintro x ⟨e, rfl⟩
    exact ⟨[(e, true)], by simp⟩
  · exact ⟨[], by simp⟩
  · rintro x y _ _ ⟨wx, ex⟩ ⟨wy, ey⟩
    exact ⟨wx ++ wy, by simp [List.map_append, List.prod_append, ex, ey]⟩
  · rintro x _ ⟨w, ew⟩
    refine ⟨w.reverse.map (fun letter ↦ (letter.1, !letter.2)), ?_⟩
    rw [ew, List.prod_inv_reverse]
    simp only [List.map_reverse, List.map_map, Function.comp_def]
    apply congrArg (fun l : List G ↦ l.reverse.prod)
    apply List.map_congr_left
    intro a _
    cases a.2 <;> simp

end HolomorphicAnosov.Topology

