import HolomorphicAnosov.Topology.RelativeTriangleRealization.CompactClosedRelationQuotient
import HolomorphicAnosov.Topology.RelativeTriangleRealization.Basic
import HolomorphicAnosov.Topology.RelativeTriangleRealization.InteriorClasses
import HolomorphicAnosov.Topology.RelativeTriangleRealization.EdgeInteriorClasses
import HolomorphicAnosov.Topology.RelativeTriangleRealization.VertexClassStratum
import HolomorphicAnosov.Topology.RelativeTriangleRealization.PairedTriangleRelationClassification

noncomputable section
namespace HolomorphicAnosov.RelativeTriangleRealization

/-!
The next provider is the closed-relation part of the finite face-pairing
argument.  Source: Hatcher, *Algebraic Topology*, p.167 and Appendix A.3,
pp.521–522.  The relation is generated by finitely many face identifications.
The open triangle stratum is diagonal by `triangleInterior_eq_iff`, an open
edge stratum has the two-point pairing class by `edgeInterior_class_iff`, and
the remaining vertex stratum is finite by `vertexClass_classifies` and
`VertexClassFinite`.  Each stratum relation is closed in the compact simplex
union, so their finite union is closed.  This named provider records the one
remaining formalization step and is kept separate from the general quotient
Hausdorff lemma in `CompactClosedRelationQuotient`.
-/
theorem pairedTriangle_relation_isClosed {m : ℕ}
    (pair : Occurrence m → Occurrence m)
    (hinv : Function.Involutive pair) :
    IsClosed {
      p : (Fin m × Simplex 2) × (Fin m × Simplex 2) |
        Relation.EqvGen (pointRelation pair) p.1 p.2 } := by
  let : T2Space (Simplex 2) :=
    (Convexity.StdSimplex.isEmbedding_toFun_comp_weights ℝ (Fin 3)).t2Space
  let X := Fin m × Simplex 2
  let R : Set (X × X) := {p | Relation.EqvGen (pointRelation pair) p.1 p.2}
  let V : Set X := Set.range (fun v : Fin m × Fin 3 ↦
    (v.1, Convexity.StdSimplex.single v.2))
  let F (o : Occurrence m) (t : Simplex 1) : X × X :=
    ((o.1, face o.2 t), ((pair o).1, face (pair o).2 t))
  let E : Set (X × X) := ⋃ o : Occurrence m, F o '' (Set.univ : Set (Simplex 1))
  let Er : Set (X × X) := ⋃ o : Occurrence m,
    (fun t ↦ (F o t).swap) '' (Set.univ : Set (Simplex 1))
  let D : Set (X × X) := {p | p.1 = p.2}
  let RV : Set (X × X) := R ∩ (V ×ˢ V)
  have hVfinite : V.Finite := Set.finite_range _
  have hRVfinite : RV.Finite := by
    apply (hVfinite.prod hVfinite).subset
    intro p hp
    exact hp.2
  have hRVclosed : IsClosed RV := hRVfinite.isClosed
  have hDclosed : IsClosed D := by
    simpa [D] using (isClosed_eq (continuous_fst : Continuous (Prod.fst : X × X → X))
      (continuous_snd : Continuous (Prod.snd : X × X → X)))
  have hEclosed : IsClosed E := by
    apply isClosed_iUnion_of_finite
    intro o
    apply (isCompact_univ.image ?_).isClosed
    exact ((continuous_const.prodMk (face o.2).continuous).prodMk
      (continuous_const.prodMk (face (pair o).2).continuous))
  have hErclosed : IsClosed Er := by
    apply isClosed_iUnion_of_finite
    intro o
    apply (isCompact_univ.image ?_).isClosed
    exact ((continuous_const.prodMk (face (pair o).2).continuous).prodMk
      (continuous_const.prodMk (face o.2).continuous))
  have hEq : R = D ∪ (RV ∪ (E ∪ Er)) := by
    ext p
    constructor
    · intro hp
      rcases pairedTriangle_eqvGen_classification pair hinv hp with h | h | h | h
      · exact Or.inl (show p ∈ D from h)
      · exact Or.inr (Or.inl (show p ∈ RV from ⟨hp, by
          constructor
          · simpa [V] using (show ∃ v : Fin m × Fin 3,
                (v.1, Convexity.StdSimplex.single v.2) = p.1 from
              ⟨Classical.choose h.1, (Classical.choose_spec h.1).symm⟩)
          · simpa [V] using (show ∃ v : Fin m × Fin 3,
                (v.1, Convexity.StdSimplex.single v.2) = p.2 from
              ⟨Classical.choose h.2.1, (Classical.choose_spec h.2.1).symm⟩)⟩))
      · exact Or.inr (Or.inr (Or.inl (by
          rcases h with ⟨o, t, h1, h2⟩
          exact Set.mem_iUnion.mpr ⟨o, (Set.mem_image _ _ _).2 ⟨t, Set.mem_univ _, by
            exact Prod.ext h1.symm h2.symm⟩⟩)) )
      · exact Or.inr (Or.inr (Or.inr (by
          rcases h with ⟨o, t, h1, h2⟩
          exact Set.mem_iUnion.mpr ⟨o, (Set.mem_image _ _ _).2 ⟨t, Set.mem_univ _, by
            exact Prod.ext h2.symm h1.symm⟩⟩)) )
    · intro hp
      rcases hp with hp | hp
      · change p.1 = p.2 at hp
        change Relation.EqvGen (pointRelation pair) p.1 p.2
        rw [← hp]
        exact Relation.EqvGen.refl _
      · rcases hp with hp | hp
        · exact hp.1
        · rcases hp with hp | hp
          · change p ∈ E at hp
            rcases Set.mem_iUnion.mp hp with ⟨o, hp⟩
            rcases (Set.mem_image _ _ _).1 hp with ⟨t, -, rfl⟩
            exact Relation.EqvGen.rel _ _ ⟨o, t, rfl, rfl⟩
          · change p ∈ Er at hp
            rcases Set.mem_iUnion.mp hp with ⟨o, hp⟩
            rcases (Set.mem_image _ _ _).1 hp with ⟨t, -, rfl⟩
            exact Relation.EqvGen.symm _ _ (Relation.EqvGen.rel _ _ ⟨o, t, rfl, rfl⟩)
  change IsClosed R
  rw [hEq]
  exact hDclosed.union (hRVclosed.union (hEclosed.union hErclosed))

/-- Named source-backed construction obligation for the Hausdorff paired-triangle quotient.

Source: Hatcher, Algebraic Topology, pp.103–104 and p.167, Appendix A.3
pp.521–522. Interior, edge, and vertex strata make the generated relation
closed in a finite compact disjoint union; compact closed-relation quotients
are Hausdorff. The extra proposition parameter only keeps this construction
separate from the public statement while its formal quotient argument is
completed.
-/
theorem pairedTriangle_quotient_t2_construction {m : ℕ}
    (pair : Occurrence m → Occurrence m)
    (hinv : Function.Involutive pair)
    (_haux : True) :
    T2Space (Space pair) := by
  let : T2Space (Simplex 2) :=
    (Convexity.StdSimplex.isEmbedding_toFun_comp_weights ℝ (Fin 3)).t2Space
  apply t2Space_quotient_of_closed_relation
    (Relation.EqvGen.setoid (pointRelation pair))
  exact pairedTriangle_relation_isClosed pair hinv

end HolomorphicAnosov.RelativeTriangleRealization
