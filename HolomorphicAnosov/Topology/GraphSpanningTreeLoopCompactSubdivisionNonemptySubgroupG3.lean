import HolomorphicAnosov.Topology.GraphSpanningTreeLoopCompactSubdivisionNonemptyWordG3
import HolomorphicAnosov.Topology.GraphSpanningTreeLoopFiniteWordClosureG3
import HolomorphicAnosov.Topology.GraphSpanningTreeLoopQuotientPresentationDataG3
import HolomorphicAnosov.Topology.GraphSpanningTreeLoopSubdivisionDataG3
import Mathlib.Topology.CWComplex.Classical.Graph
import Mathlib.Combinatorics.Graph.Simple
import Mathlib.Combinatorics.Graph.Delete
import Mathlib.Combinatorics.SimpleGraph.Acyclic
import Mathlib.AlgebraicTopology.FundamentalGroupoid.FundamentalGroup

open _root_.Topology
namespace HolomorphicAnosov

/-- Nonempty-complement residual for the compact weak-wedge spanning-tree argument.

Source: Hatcher, *Algebraic Topology*, graph quotient p.83, Proposition 1A.2
proof pp.84--85, Lemma 1.15 p.35, and Theorem 1.7 pp.29--31.  After the rooted
collapse, compact subdivision of a loop in the weak wedge, cancellation of
vertex-collar segments, and winding on each selected characteristic circle give
membership in the subgroup generated by the rooted non-tree edge loops.  The
explicit complementary-edge premise records the branch in which the circle
wedge is nonempty; all quotient and winding data are retained in this named
source residual for proof against the current Mathlib CW interfaces.
-/
theorem graph_spanning_tree_loop_compact_subdivision_nonempty_subgroup_g3
    {X : Type*} [TopologicalSpace X] [T2Space X] [ConnectedSpace X]
    [CWComplex (Set.univ : Set X)]
    (hdim : ∀ n : ℕ, 1 < n → IsEmpty (RelCWComplex.cell (Set.univ : Set X) n))
    (T : RelCWComplex.Subcomplex (Set.univ : Set X))
    (hT0 : T.I 0 = Set.univ)
    (hTsimple : ((CWComplex.OneSkeletonGraph (Set.univ : Set X)).restrict (T.I 1)).Simple)
    (hTtree : ((CWComplex.OneSkeletonGraph (Set.univ : Set X)).restrict (T.I 1)).toSimpleGraph.IsTree)
    (v0 : RelCWComplex.cell (Set.univ : Set X) 0)
    (u v : RelCWComplex.cell (Set.univ : Set X) 1 → RelCWComplex.cell (Set.univ : Set X) 0)
    (rev : RelCWComplex.cell (Set.univ : Set X) 1 → Bool)
    (edgePath : ∀ e, Path (RelCWComplex.map (C := Set.univ) 0 (u e) ![])
      (RelCWComplex.map (C := Set.univ) 0 (v e) ![]))
    (hedge : ∀ e t, edgePath e t = RelCWComplex.map (C := Set.univ) 1 e
      (fun _ ↦ if rev e then 1 - 2 * (t : ℝ) else 2 * (t : ℝ) - 1))
    (q : ∀ w, Path (RelCWComplex.map (C := Set.univ) 0 v0 ![])
      (RelCWComplex.map (C := Set.univ) 0 w ![]))
    (hq : ∀ w t, q w t ∈ (T : Set X))
    (hE : ∃ e : RelCWComplex.cell (Set.univ : Set X) 1, e ∉ T.I 1) :
    let pt := fun w : RelCWComplex.cell (Set.univ : Set X) 0 ↦ RelCWComplex.map (C := Set.univ) 0 w ![]
    let E := {e : RelCWComplex.cell (Set.univ : Set X) 1 // e ∉ T.I 1}
    let generator : E → FundamentalGroup X (pt v0) := fun e ↦ FundamentalGroup.fromPath
      (Path.Homotopic.Quotient.mk (((q (u e)).trans (edgePath e)).trans (q (v e)).symm))
    ∀ α : FundamentalGroup X (pt v0), α ∈ Subgroup.closure (Set.range generator) := by
  dsimp
  let pt := fun w : RelCWComplex.cell (Set.univ : Set X) 0 ↦
    RelCWComplex.map (C := Set.univ) 0 w ![]
  let E := {e : RelCWComplex.cell (Set.univ : Set X) 1 // e ∉ T.I 1}
  let generator : E → FundamentalGroup X (pt v0) := fun e ↦
    FundamentalGroup.fromPath (Path.Homotopic.Quotient.mk
      (((q (u e)).trans (edgePath e)).trans (q (v e)).symm))
  intro α
  obtain ⟨word, hword⟩ := graph_spanning_tree_loop_compact_subdivision_nonempty_word_g3
    hdim T hT0 hTsimple hTtree v0 u v rev edgePath hedge q hq hE α
  apply Topology.graph_spanning_tree_loop_finite_word_closure_g3 generator
    (fun w : List (E × Bool) ↦
      (w.map (fun letter ↦ if letter.2 then generator letter.1 else
        (generator letter.1)⁻¹)).prod)
  · constructor
    · simp
    · intro a w
      simp
  · exact ⟨word, hword⟩

end HolomorphicAnosov
