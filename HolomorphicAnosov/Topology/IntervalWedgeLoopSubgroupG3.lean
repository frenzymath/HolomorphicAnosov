import HolomorphicAnosov.Topology.OpenCoverRootedPathSubgroupG3
import Mathlib.AlgebraicTopology.FundamentalGroupoid.SimplyConnected
import Mathlib.Topology.Homeomorph.Lemmas

/-! The interval-chart form of the weak-wedge loop generation argument.
Source: Hatcher, Algebraic Topology, Lemma 1.15, p.35, and Proposition 1A.2, pp.84–85.
The explicit interval lifting argument is an agent-written expansion of that proof. -/

namespace HolomorphicAnosov
open Set
local notation "Q" => Path.Homotopic.Quotient.mk

/-- An open part on which a quotient map has singleton fibres embeds openly.
Source: Hatcher, quotient topology p.10; an open image has the same open preimage
before and after the quotient, and singleton fibres give injectivity. -/
theorem quotient_open_embedding_of_singleton_fibres_g3
    {A B C : Type*} [TopologicalSpace A] [TopologicalSpace B] [TopologicalSpace C]
    {f : A → B} {j : C → A} (hf : _root_.Topology.IsQuotientMap f)
    (hj : _root_.Topology.IsOpenEmbedding j)
    (hfibre : ∀ c a, f a = f (j c) → a = j c) :
    _root_.Topology.IsOpenEmbedding (f ∘ j) := by
  apply _root_.Topology.isOpenEmbedding_iff_continuous_injective_isOpenMap.mpr
  refine ⟨hf.continuous.comp hj.continuous, ?_, ?_⟩
  · intro c d h
    exact hj.injective (hfibre d (j c) h)
  · intro s hs
    apply hf.isOpen_preimage.mp
    have heq : f ⁻¹' ((f ∘ j) '' s) = j '' s := by
      ext a
      constructor
      · rintro ⟨c, hc, h⟩
        exact ⟨c, hc, (hfibre c a h.symm).symm⟩
      · rintro ⟨c, hc, rfl⟩
        exact ⟨c, hc, rfl⟩
    rw [heq]
    exact hj.isOpenMap s hs

/-- A root-fixed contraction kills every based loop in the contracted set.
Source: Hatcher, homotopy of loops pp.25–26; compose the contraction with the loop. -/
theorem loop_null_of_rooted_contraction_g3
    {X : Type*} [TopologicalSpace X] {b : X} {V : Set X} (hb : b ∈ V)
    (H : C(unitInterval × V, X)) (h0 : ∀ y, H (0, y) = y.val)
    (h1 : ∀ y, H (1, y) = b) (hroot : ∀ t, H (t, ⟨b, hb⟩) = b)
    (p : Path b b) (hp : ∀ t, p t ∈ V) : p.Homotopic (Path.refl b) := by
  refine ⟨{
    toFun := fun z ↦ H (z.1, ⟨p z.2, hp z.2⟩)
    continuous_toFun := H.continuous.comp (continuous_fst.prodMk
      ((p.continuous.comp continuous_snd).subtype_mk _))
    map_zero_left := fun t ↦ h0 _
    map_one_left := fun t ↦ h1 _
    prop' := ?_ }⟩
  intro t s hs
  rcases hs with rfl | rfl
  · change H (t, ⟨p 0, hp 0⟩) = p 0
    simpa only [p.source] using hroot t
  · change H (t, ⟨p 1, hp 1⟩) = p 1
    simpa only [p.target] using hroot t

/-- A path in a simply connected characteristic disk between its two marked endpoints
maps to the edge loop, its reverse, or the constant loop.
Source: Hatcher, Proposition 1A.2 pp.84–85; simple connectedness identifies the
lift with a marked endpoint path, and the four endpoint cases give the claim. -/
theorem mapped_endpoint_path_mem_g3
    {D X : Type*} [TopologicalSpace D] [SimplyConnectedSpace D] [TopologicalSpace X]
    (χ : C(D, X)) (lo hi : D) (b : X) (hlo : χ lo = b) (hhi : χ hi = b)
    (edge : Path lo hi) (K : Subgroup (FundamentalGroup X b))
    (hedge : FundamentalGroup.fromPath (Q ((edge.map χ.continuous).cast hlo.symm hhi.symm)) ∈ K)
    {v w : D} (hv : v = lo ∨ v = hi) (hw : w = lo ∨ w = hi)
    (p : Path v w) (hvχ : χ v = b) (hwχ : χ w = b) :
    FundamentalGroup.fromPath (Q ((p.map χ.continuous).cast hvχ.symm hwχ.symm)) ∈ K := by
  rcases hv with hv | hv <;> rcases hw with hw | hw <;> subst v <;> subst w
  · have h := ((SimplyConnectedSpace.paths_homotopic p (Path.refl lo)).map χ).pathCast
      hvχ.symm hwχ.symm
    have he : ((Path.refl lo).map χ.continuous).cast hvχ.symm hwχ.symm = Path.refl b := by
      ext t; exact hlo
    rw [he] at h
    exact (Path.Homotopic.Quotient.eq.mpr h).symm ▸ K.one_mem
  · have h := ((SimplyConnectedSpace.paths_homotopic p edge).map χ).pathCast
      hvχ.symm hwχ.symm
    exact (Path.Homotopic.Quotient.eq.mpr h).symm ▸ hedge
  · have h := ((SimplyConnectedSpace.paths_homotopic p edge.symm).map χ).pathCast
      hvχ.symm hwχ.symm
    have he : ((edge.symm.map χ.continuous).cast hvχ.symm hwχ.symm) =
        ((edge.map χ.continuous).cast hlo.symm hhi.symm).symm := by
      ext t; rfl
    rw [he] at h
    exact (Path.Homotopic.Quotient.eq.mpr h).symm ▸ K.inv_mem hedge
  · have h := ((SimplyConnectedSpace.paths_homotopic p (Path.refl hi)).map χ).pathCast
      hvχ.symm hwχ.symm
    have he : ((Path.refl hi).map χ.continuous).cast hvχ.symm hwχ.symm = Path.refl b := by
      ext t; exact hhi
    rw [he] at h
    exact (Path.Homotopic.Quotient.eq.mpr h).symm ▸ K.one_mem

/-- Compact loops in a wedge are generated by its characteristic intervals.
Source: Hatcher, Lemma 1.15 p.35 and Proposition 1A.2 pp.84–85.
The chosen root paths lift to paths from either marked endpoint in each disk.
On the collar the rooted contraction kills loops. On an interval chart, lift a
subpath and its two root connectors to the simply connected disk; its endpoint
pair identifies it with the edge, its inverse, or a constant. Finite subdivision
and cancellation then give membership in the edge-generated subgroup. -/
theorem interval_wedge_loop_subgroup_g3
    {D X E : Type*} [TopologicalSpace D] [SimplyConnectedSpace D] [TopologicalSpace X]
    (χ : E → C(D, X)) (lo hi : D) (b : X)
    (hlo : ∀ e, χ e lo = b) (hhi : ∀ e, χ e hi = b)
    (edge : Path lo hi) (A : Set D)
    (hemb : ∀ e, _root_.Topology.IsOpenEmbedding (fun z : A ↦ χ e z.val))
    (V : Set X) (hV : IsOpen V) (hb : b ∈ V)
    (hcover : ∀ y, y ∈ V ∨ ∃ e, y ∈ Set.range (fun z : A ↦ χ e z.val))
    (H : C(unitInterval × V, X)) (hH0 : ∀ y, H (0, y) = y.val)
    (hH1 : ∀ y, H (1, y) = b) (hHb : ∀ t, H (t, ⟨b, hb⟩) = b)
    (G : X → C(unitInterval, X)) (hG0 : ∀ y, G y 0 = y) (hG1 : ∀ y, G y 1 = b)
    (hGb : ∀ t, G b t = b) (hGmem : ∀ y ∈ V, ∀ t, G y t ∈ V)
    (hGlift : ∀ e z, ∃ v, (v = lo ∨ v = hi) ∧
      ∃ l : Path z v, ∀ t, G (χ e z) t = χ e (l t))
    (K : Subgroup (FundamentalGroup X b))
    (hedge : ∀ e, FundamentalGroup.fromPath
      (Q ((edge.map (χ e).continuous).cast (hlo e).symm (hhi e).symm)) ∈ K)
    (γ : Path b b) : FundamentalGroup.fromPath (Q γ) ∈ K := by
  classical
  let q : ∀ y, Path b y := fun y ↦ (⟨G y, hG0 y, hG1 y⟩ : Path y b).symm
  have hq : (q b).Homotopic (Path.refl b) := by
    have he : q b = Path.refl b := by ext t; exact hGb _
    rw [he]
  let U : Option E → Set X := fun o ↦ o.elim V (fun e ↦ Set.range (fun z : A ↦ χ e z.val))
  apply openCover_rooted_path_subgroup_g3 U
    (fun o ↦ by cases o with | none => exact hV | some e => exact (hemb e).isOpen_range)
    (fun y ↦ by
      rcases hcover y with hy | ⟨e, he⟩
      · exact ⟨none, hy⟩
      · exact ⟨some e, he⟩) q hq K ?_ γ
  intro i a c p hp
  cases i with
  | none =>
    change ∀ t, p t ∈ V at hp
    have ha : a ∈ V := by simpa only [Path.source] using hp 0
    have hc : c ∈ V := by simpa only [Path.target] using hp 1
    have hqa : ∀ t, q a t ∈ V := fun t ↦ hGmem a ha _
    have hqc : ∀ t, (q c).symm t ∈ V := by
      intro t
      simp only [q, Path.symm_symm]
      exact hGmem c hc t
    have hloop : ∀ t, (((q a).trans p).trans (q c).symm) t ∈ V := by
      apply Set.range_subset_iff.mp
      rw [Path.trans_range, Path.trans_range]
      exact Set.union_subset (Set.union_subset (Set.range_subset_iff.mpr hqa)
        (Set.range_subset_iff.mpr hp)) (Set.range_subset_iff.mpr hqc)
    have h := loop_null_of_rooted_contraction_g3 hb H hH0 hH1 hHb _ hloop
    exact (Path.Homotopic.Quotient.eq.mpr h).symm ▸ K.one_mem
  | some e =>
    let j : A → X := fun z ↦ χ e z.val
    change ∀ t, p t ∈ Set.range j at hp
    have ha : a ∈ Set.range j := by simpa only [Path.source] using hp 0
    have hc : c ∈ Set.range j := by simpa only [Path.target] using hp 1
    let homeo := (hemb e).isEmbedding.toHomeomorph
    let za : A := homeo.symm ⟨a, ha⟩
    let zc : A := homeo.symm ⟨c, hc⟩
    have hza : χ e za.val = a := congrArg Subtype.val (homeo.apply_symm_apply ⟨a, ha⟩)
    have hzc : χ e zc.val = c := congrArg Subtype.val (homeo.apply_symm_apply ⟨c, hc⟩)
    let pRange : Path (⟨a, ha⟩ : Set.range j) ⟨c, hc⟩ :=
      ⟨⟨fun t ↦ ⟨p t, hp t⟩, p.continuous.subtype_mk _⟩,
        Subtype.ext p.source, Subtype.ext p.target⟩
    let η : Path za.val zc.val :=
      (pRange.map homeo.symm.continuous).map continuous_subtype_val
    have hη (t) : χ e (η t) = p t :=
      congrArg Subtype.val (homeo.apply_symm_apply ⟨p t, hp t⟩)
    obtain ⟨va, hva, la, hla⟩ := hGlift e za.val
    obtain ⟨vc, hvc, lc, hlc⟩ := hGlift e zc.val
    have hχva : χ e va = b := hva.elim (fun h ↦ h ▸ hlo e) (fun h ↦ h ▸ hhi e)
    have hχvc : χ e vc = b := hvc.elim (fun h ↦ h ▸ hlo e) (fun h ↦ h ▸ hhi e)
    let L : Path va vc := (la.symm.trans η).trans lc
    have hqa : ((la.symm.map (χ e).continuous).cast hχva.symm hza.symm) = q a := by
      ext t
      change χ e (la (unitInterval.symm t)) = G a (unitInterval.symm t)
      rw [← hla, hza]
    have hp' : (η.map (χ e).continuous).cast hza.symm hzc.symm = p := by
      ext t; exact hη t
    have hqc : (lc.map (χ e).continuous).cast hzc.symm hχvc.symm = (q c).symm := by
      simp only [q, Path.symm_symm]
      ext t
      change χ e (lc t) = G c t
      rw [← hlc, hzc]
    have hL : (L.map (χ e).continuous).cast hχva.symm hχvc.symm =
        ((q a).trans p).trans (q c).symm := by
      dsimp only [L]
      rw [Path.map_trans, Path.map_trans]
      change ((((la.symm.map (χ e).continuous).cast hχva.symm hza.symm).trans
        ((η.map (χ e).continuous).cast hza.symm hzc.symm)).trans
        ((lc.map (χ e).continuous).cast hzc.symm hχvc.symm)) = _
      rw [hqa, hp', hqc]
    rw [← hL]
    exact mapped_endpoint_path_mem_g3 (χ e) lo hi b (hlo e) (hhi e) edge K
      (hedge e) hva hvc L hχva hχvc


end HolomorphicAnosov
