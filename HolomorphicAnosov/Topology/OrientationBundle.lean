import Mathlib.LinearAlgebra.Orientation
import Mathlib.Topology.VectorBundle.Basic

/-!
# The orientation bundle of a finite-rank real vector bundle

This file defines the orientation fibres, their topology, and the comparison sign. (Hatcher, pp. 6, 24–25)
-/

namespace HolomorphicAnosov

noncomputable section

open Bundle Topology _root_.Topology

/-- Ordered bases modulo equality of basis orientations. -/
abbrev RealBasisOrientation (d : ℕ) (V : Type*) [AddCommGroup V] [Module ℝ V] :=
  Quotient (Setoid.ker (fun b : Module.Basis (Fin d) ℝ V ↦ b.orientation))

/-- Each orientation fibre and the model orientation fibre have the discrete topology. -/
instance realBasisOrientationTopology (d : ℕ) (V : Type*)
    [AddCommGroup V] [Module ℝ V] : TopologicalSpace (RealBasisOrientation d V) := ⊥

/-- Pushforward of an orientation by a linear isomorphism. -/
def realOrientationMap {d : ℕ} {V W : Type*} [AddCommGroup V] [Module ℝ V]
    [AddCommGroup W] [Module ℝ W] (L : V ≃ₗ[ℝ] W) :
    RealBasisOrientation d V → RealBasisOrientation d W :=
  Quotient.map (fun b ↦ b.map L) (fun a b h ↦ by
    change (a.map L).orientation = (b.map L).orientation
    simpa only [Module.Basis.orientation_map] using congrArg (Orientation.map (Fin d) L) h)

variable {B : Type*} [TopologicalSpace B] (d : ℕ) (E : B → Type*)
variable [∀ b, AddCommGroup (E b)] [∀ b, Module ℝ (E b)]
variable [∀ b, TopologicalSpace (E b)]
variable [TopologicalSpace (Bundle.TotalSpace (Fin d → ℝ) E)]

/-- The orientation carrier with its base point and quotient fibre. -/
abbrev RealOrientationTotal := Σ b : B, RealBasisOrientation d (E b)

/-- The inverse orientation map associated with a linear chart. -/
def realOrientationChartInverse
    (e : Trivialization (Fin d → ℝ) (Bundle.TotalSpace.proj :
      Bundle.TotalSpace (Fin d → ℝ) E → B)) [e.IsLinear ℝ] :
    e.baseSet × RealBasisOrientation d (Fin d → ℝ) → RealOrientationTotal d E :=
  fun z ↦ ⟨z.1.val, realOrientationMap (e.linearEquivAt ℝ z.1.val z.1.property).symm z.2⟩

/-- The final topology generated by the inverse orientation maps of linear charts. -/
@[instance_reducible]
def realOrientationTopology : TopologicalSpace (RealOrientationTotal d E) :=
  ⨆ (e : Trivialization (Fin d → ℝ) (Bundle.TotalSpace.proj :
    Bundle.TotalSpace (Fin d → ℝ) E → B)) (h : e.IsLinear ℝ),
    letI := h
    TopologicalSpace.coinduced (realOrientationChartInverse d E e) inferInstance

open scoped Classical in
/-- The comparison sign of two orientations, valued in `ℤˣ`; it is `1` exactly when they agree. -/
def realOrientationComparison {V W : Type*} [AddCommGroup V] [Module ℝ V]
    [AddCommGroup W] [Module ℝ W] (L : V ≃ₗ[ℝ] W)
    (o : RealBasisOrientation d V) (o' : RealBasisOrientation d W) : ℤˣ :=
  if realOrientationMap L o = o' then 1 else -1

end

end HolomorphicAnosov
