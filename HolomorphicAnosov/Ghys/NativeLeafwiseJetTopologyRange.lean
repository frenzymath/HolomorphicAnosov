import HolomorphicAnosov.Ghys.JetDynamics
import HolomorphicAnosov.Ghys.NativeLeafwiseParametrizationJetBundle

/-! Native and leaf-family flowbox jet topologies agree after replacing the finite family by its range. -/

namespace HolomorphicAnosov.Ghys

open scoped Manifold ContDiff
universe u

/-- The native first-jet topology agrees with the leaf-family topology generated by the same finite flowbox family viewed through its range. (Ghys, §3) -/
theorem nativeLeafwiseJet1Topology_eq_leafFamilyJet1Topology_range
    {d : ℕ} {M : Type u} [TopologicalSpace M]
    [ChartedSpace (ComplexModel d) M] [IsManifold (complexModel d) ∞ M]
    {ι : Type u} {L : ι → Type u}
    [∀ i, TopologicalSpace (L i)]
    [∀ i, ChartedSpace (Fin 2 → ℝ) (L i)]
    [∀ i, IsManifold 𝓘(ℝ, Fin 2 → ℝ) ∞ (L i)]
    [∀ i, ChartedSpace ℂ (L i)]
    [∀ i, IsManifold 𝓘(ℂ) ∞ (L i)]
    {D : RealTangentDistribution (realModel d) M}
    (U : HPS.LeafPartition D ι L (fun _ ↦ 2))
    {n : ℕ}
    (c : Fin n → OpenPartialHomeomorph M (ℂ × (Fin (2 * d - 2) → ℝ))) :
    nativeLeafwiseJet1Topology L U c =
      leafFamilyJet1Topology L (fun i ↦ (U.leaf i).inclusion) (Set.range c) := by
  unfold nativeLeafwiseJet1Topology leafFamilyJet1Topology
  congr 1
  ext s
  constructor
  · rintro ⟨i, O, hO, rfl⟩
    exact ⟨c i, ⟨i, rfl⟩, O, hO, rfl⟩
  · rintro ⟨ci, ⟨i, rfl⟩, O, hO, rfl⟩
    exact ⟨i, O, hO, rfl⟩

/-- The native second-jet topology agrees with the corresponding leaf-family topology after replacing the finite flowbox family by its range. (Ghys, §3) -/
theorem nativeLeafwiseJet2Topology_eq_leafFamilyJet2Topology_range
    {d : ℕ} {M : Type u} [TopologicalSpace M]
    [ChartedSpace (ComplexModel d) M] [IsManifold (complexModel d) ∞ M]
    {ι : Type u} {L : ι → Type u}
    [∀ i, TopologicalSpace (L i)]
    [∀ i, ChartedSpace (Fin 2 → ℝ) (L i)]
    [∀ i, IsManifold 𝓘(ℝ, Fin 2 → ℝ) ∞ (L i)]
    [∀ i, ChartedSpace ℂ (L i)]
    [∀ i, IsManifold 𝓘(ℂ) ∞ (L i)]
    {D : RealTangentDistribution (realModel d) M}
    (U : HPS.LeafPartition D ι L (fun _ ↦ 2))
    {n : ℕ}
    (c : Fin n → OpenPartialHomeomorph M (ℂ × (Fin (2 * d - 2) → ℝ))) :
    nativeLeafwiseJet2Topology L U c =
      leafFamilyJet2Topology L (fun i ↦ (U.leaf i).inclusion) (Set.range c) := by
  unfold nativeLeafwiseJet2Topology leafFamilyJet2Topology
  congr 1
  ext s
  constructor
  · rintro ⟨i, O, hO, rfl⟩
    exact ⟨c i, ⟨i, rfl⟩, O, hO, rfl⟩
  · rintro ⟨ci, ⟨i, rfl⟩, O, hO, rfl⟩
    exact ⟨i, O, hO, rfl⟩

end HolomorphicAnosov.Ghys
