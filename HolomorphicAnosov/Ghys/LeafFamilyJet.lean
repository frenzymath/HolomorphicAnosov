import HolomorphicAnosov.Ghys.CurveJetReparametrization

/-! Original leaf-family jet carriers and flowbox-generated topologies. Source: Ghys p.591. -/
noncomputable section
namespace HolomorphicAnosov.Ghys
open Filter Set TopologicalSpace
open scoped Topology Manifold ContDiff
section Families

universe u v w

variable {Q : Type u} (L : Q → Type v)
  [∀ q, TopologicalSpace (L q)] [∀ q, ChartedSpace ℂ (L q)]
  [∀ q, IsManifold 𝓘(ℂ) ∞ (L q)]

/-- The disjoint union of the original first-contact quotients, indexed by actual leaves. -/
abbrev LeafFamilyJet1 := (q : Q) × CurveJet1 (L q)

/-- The corresponding total second-contact quotient carrier. -/
abbrev LeafFamilyJet2 := (q : Q) × CurveJet2 (L q)

variable {M : Type w} [TopologicalSpace M] (inclusion : ∀ q, L q → M)

/-- The literal base immersion of the original parametrization first jet. -/
def leafFamilyJet1Base (j : LeafFamilyJet1 L) : M :=
  inclusion j.1 (curveJet1Base (L j.1) j.2)

/-- The literal base immersion at order two. -/
def leafFamilyJet2Base (j : LeafFamilyJet2 L) : M :=
  inclusion j.1 (curveJet2Base (L j.1) j.2)

/-- Total truncation acts on the same original leaf-valued germ. -/
def leafFamilyJetTruncation (j : LeafFamilyJet2 L) : LeafFamilyJet1 L :=
  ⟨j.1, curveJetTruncation (L j.1) j.2⟩

variable {T : Type*} [TopologicalSpace T]

/-- First coefficient chart formed from the actual ambient flowbox and leaf germ. Source: Ghys p.591. -/
def leafFamilyJet1Coeff (c : OpenPartialHomeomorph M (ℂ × T))
    (j : LeafFamilyJet1 L) : (ℂ × T) × ℂ :=
  (c (leafFamilyJet1Base L inclusion j),
    germFirst (j.2.out.val.map (fun x : L j.1 ↦ (c (inclusion j.1 x)).1)))

/-- The normalized quadratic coefficient is evaluated on that same original germ. Source: Ghys p.591. -/
def leafFamilyJet2Coeff (c : OpenPartialHomeomorph M (ℂ × T))
    (j : LeafFamilyJet2 L) : ((ℂ × T) × ℂ) × ℂ :=
  ((c (leafFamilyJet2Base L inclusion j),
    germFirst (j.2.out.val.map (fun x : L j.1 ↦ (c (inclusion j.1 x)).1))),
    germSecond (j.2.out.val.map (fun x : L j.1 ↦ (c (inclusion j.1 x)).1)))

/-- The original total first-jet topology generated by actual flowbox coefficient charts. Source: Ghys p.591. -/
@[instance_reducible]
def leafFamilyJet1Topology (boxes : Set (OpenPartialHomeomorph M (ℂ × T))) :
    TopologicalSpace (LeafFamilyJet1 L) :=
  TopologicalSpace.generateFrom {s | ∃ c ∈ boxes, ∃ O : Set ((ℂ × T) × ℂ),
    IsOpen O ∧ s = {j | leafFamilyJet1Base L inclusion j ∈ c.source ∧
      leafFamilyJet1Coeff L inclusion c j ∈ O}}

/-- The same coefficient-generated topology at order two. Source: Ghys p.591. -/
@[instance_reducible]
def leafFamilyJet2Topology (boxes : Set (OpenPartialHomeomorph M (ℂ × T))) :
    TopologicalSpace (LeafFamilyJet2 L) :=
  TopologicalSpace.generateFrom {s | ∃ c ∈ boxes, ∃ O : Set (((ℂ × T) × ℂ) × ℂ),
    IsOpen O ∧ s = {j | leafFamilyJet2Base L inclusion j ∈ c.source ∧
      leafFamilyJet2Coeff L inclusion c j ∈ O}}

/-- Total rational source action keeps the original leaf and precomposes its germ. -/
def leafFamilyJet1Source (omega : ℂˣ) (_μ : ℂ) (j : LeafFamilyJet1 L) : LeafFamilyJet1 L :=
  ⟨j.1, curveJet1Scale (L j.1) omega j.2⟩

/-- Total source action at order two. -/
def leafFamilyJet2Source (omega : ℂˣ) (μ : ℂ) (j : LeafFamilyJet2 L) : LeafFamilyJet2 L :=
  ⟨j.1, curveJet2Reparametrize (L j.1) ⟨omega, μ⟩ j.2⟩

end Families
end HolomorphicAnosov.Ghys
