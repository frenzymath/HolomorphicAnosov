import Mathlib.Geometry.Manifold.ChartedSpace

/-! This file constructs a charted-space atlas from compatible coefficient coordinates. (Lee, Lemma 1.23) -/
open Set
namespace HolomorphicAnosov.Ghys
universe u v w

/-- Compatible coefficient coordinate bijections form exactly the atlas for the topology generated by their inverse images of open sets. (Lee, Lemma 1.23) -/
theorem generated_coefficient_atlas
    {C : Type u} {J : Type v} {H : Type w} [TopologicalSpace H]
    (e : C → PartialEquiv J H)
    (hcover : ∀ j : J, ∃ c : C, j ∈ (e c).source)
    (hopen : ∀ c d, IsOpen ((e c).symm.trans (e d)).source)
    (hcont : ∀ c d, ContinuousOn ((e c).symm.trans (e d))
      ((e c).symm.trans (e d)).source) :
    letI : TopologicalSpace J := TopologicalSpace.generateFrom
      {s | ∃ c : C, ∃ O : Set H, IsOpen O ∧
        s = {j | j ∈ (e c).source ∧ e c j ∈ O}}
    ∃ A : ChartedSpace H J,
      (∀ c : C, ∃ E : OpenPartialHomeomorph J H,
        E ∈ A.atlas ∧ E.toPartialEquiv = e c) ∧
      (∀ E ∈ A.atlas, ∃ c : C, E.toPartialEquiv = e c) := by
  classical
  let core : ChartedSpaceCore H J := {
    atlas := range e
    chartAt := fun j ↦ e (hcover j).choose
    mem_chart_source := fun j ↦ (hcover j).choose_spec
    chart_mem_atlas := fun j ↦ mem_range_self _
    open_source := by
      rintro _ _ ⟨c, rfl⟩ ⟨d, rfl⟩
      exact hopen c d
    continuousOn_toFun := by
      rintro _ _ ⟨c, rfl⟩ ⟨d, rfl⟩
      exact hcont c d }
  have htop : core.toTopologicalSpace = TopologicalSpace.generateFrom
      {s | ∃ c : C, ∃ O : Set H, IsOpen O ∧
        s = {j | j ∈ (e c).source ∧ e c j ∈ O}} := by
    apply congrArg TopologicalSpace.generateFrom
    ext s
    simp only [mem_iUnion, mem_singleton_iff, mem_ofPred_eq, exists_prop]
    constructor
    · rintro ⟨f, ⟨c, rfl⟩, O, hO, rfl⟩
      exact ⟨c, O, hO, inter_comm _ _⟩
    · rintro ⟨c, O, hO, rfl⟩
      exact ⟨e c, mem_range_self c, O, hO, inter_comm _ _⟩
  rw [← htop]
  refine ⟨core.toChartedSpace, ?_, ?_⟩
  · intro c
    refine ⟨core.openPartialHomeomorph (e c) (mem_range_self c), ?_, rfl⟩
    exact mem_iUnion_of_mem (e c) (mem_iUnion_of_mem (mem_range_self c) (mem_singleton _))
  · intro E hE
    change E ∈ ⋃ (f : PartialEquiv J H) (hf : f ∈ core.atlas),
      {core.openPartialHomeomorph f hf} at hE
    obtain ⟨f, hEf⟩ := mem_iUnion.1 hE
    obtain ⟨hf, hEf⟩ := mem_iUnion.1 hEf
    obtain ⟨c, rfl⟩ := hf
    refine ⟨c, ?_⟩
    have hE' : E = core.openPartialHomeomorph (e c) (mem_range_self c) := hEf
    rw [hE']
    rfl

end HolomorphicAnosov.Ghys
